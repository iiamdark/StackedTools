---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  authorName?: string;
}

const { title, description, image, type = 'website', publishDate, updatedDate, authorName } = Astro.props;
---

<!html>
<html lang="en">
  <SEOHead
    title={title}
    description={description}
    image={image}
    type={type}
    publishDate={publishDate}
    updatedDate={updatedDate}
    authorName={authorName}
  />
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
