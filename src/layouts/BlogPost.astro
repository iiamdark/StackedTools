---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author = 'StackedTools Team' } = Astro.props;
---

<BaseLayout title={title} description={description} type="article" publishDate={pubDate} updatedDate={updatedDate} authorName={author}>
  <article class="article-container">
    <div class="container container-article">
      <header class="article-header">
        <div class="article-meta">
          <span class="badge badge-purple">Software Review</span>
          <time>{new Date(pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        </div>

        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>

        <div class="author-bar">
          <div class="author-info">
            <span class="by">By</span>
            <span class="author-name">{author}</span>
          </div>
          {updatedDate && (
            <span class="updated">Updated: {new Date(updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          )}
        </div>
      </header>

      {/* Top Article Ad Unit */}
      <AdUnit slotId="1000000001" format="auto" />

      <div class="article-body prose">
        <slot />
      </div>

      {/* Bottom Article Ad Unit */}
      <AdUnit slotId="1000000002" format="auto" />

      {/* Author Bio Box */}
      <div class="author-box">
        <h3>About {author}</h3>
        <p>Expert software reviewer and digital workflow researcher at StackedTools.online. Focused on objective SaaS comparisons and practical automation.</p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .article-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .author-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .author-name {
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--accent-purple);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--text-secondary);
    margin: 2rem 0;
  }

  .author-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    margin-top: 4rem;
  }

  .author-box h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .author-box p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
</style>
