---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import BackToTop from '../components/BackToTop.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author = 'StackedTools Team' } = Astro.props;
---

<BaseLayout title={title} description={description} type="article" publishDate={pubDate} updatedDate={updatedDate} authorName={author}>
  <ReadingProgress />
  <article class="article-container">
    <div class="container container-article">
      <header class="article-header">
        <div class="article-meta">
          <span class="badge badge-purple">Software Review</span>
          <time>{new Date(pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        </div>

        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>

        <div class="author-bar">
          <div class="author-info">
            <span class="by">By</span>
            <span class="author-name">{author}</span>
          </div>
          {updatedDate && (
            <span class="updated">Updated: {new Date(updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          )}
        </div>
      </header>

      <div class="article-body prose">
        <slot />
      </div>

      <div class="author-box">
        <h3>About {author}</h3>
        <p>Expert software reviewer and digital workflow researcher at StackedTools. Focused on objective SaaS comparisons and practical automation.</p>
      </div>

      <NewsletterCTA />
    </div>
  </article>
  <BackToTop />
</BaseLayout>

<style>
  .article-container {
    padding-top: var(--spacing-40);
    padding-bottom: var(--spacing-64);
  }

  .article-header {
    margin-bottom: var(--spacing-32);
    padding-bottom: var(--spacing-32);
    border-bottom: 1px solid var(--border-color);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    margin-bottom: var(--spacing-20);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--color-iron-veil);
    letter-spacing: var(--tracking-body);
  }

  .article-title {
    font-family: var(--font-inter);
    font-size: clamp(28px, 4.5vw, 40px);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    margin-bottom: var(--spacing-16);
    letter-spacing: -0.03em;
  }

  .article-description {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    line-height: var(--leading-body-lg);
    margin-bottom: var(--spacing-24);
    letter-spacing: var(--tracking-body-lg);
  }

  .author-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--color-iron-veil);
  }

  .author-name {
    color: var(--text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(h2) {
    font-family: var(--font-inter);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-bold);
    margin-top: var(--spacing-40);
    margin-bottom: var(--spacing-16);
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
  }

  .prose :global(h3) {
    font-family: var(--font-inter);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--spacing-32);
    margin-bottom: var(--spacing-12);
    color: var(--text-primary);
  }

  .prose :global(p) {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    line-height: 1.7;
    margin-bottom: var(--spacing-24);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-body-lg);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: var(--spacing-24);
    padding-left: var(--spacing-24);
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: var(--spacing-8);
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    letter-spacing: var(--tracking-body-lg);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-ember-pulse);
    background: rgba(255, 137, 100, 0.04);
    padding: var(--spacing-20) var(--spacing-24);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--text-primary);
    margin: var(--spacing-32) 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: var(--spacing-32) 0;
    background: var(--bg-card-inner);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-cards);
    overflow: hidden;
  }

  .prose :global(th) {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-family: var(--font-inter);
    font-weight: var(--font-weight-bold);
    text-align: left;
    padding: var(--spacing-16) var(--spacing-20);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border-color);
  }

  .prose :global(td) {
    padding: var(--spacing-16) var(--spacing-20);
    color: var(--text-secondary);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    border-bottom: 1px solid var(--border-subtle);
    letter-spacing: var(--tracking-body);
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.015);
    color: var(--text-primary);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-md);
    color: var(--color-electric-iris);
  }

  .prose :global(pre) {
    background: var(--color-void) !important;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-cards);
    padding: var(--spacing-24);
    overflow-x: auto;
    margin: var(--spacing-32) 0;
  }

  .prose :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-primary);
  }

  .prose :global(a) {
    color: var(--color-electric-iris);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: #6b93e5;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--spacing-40) 0;
  }

  .author-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-cards);
    padding: var(--spacing-24);
    margin-top: var(--spacing-64);
  }

  .author-box h3 {
    margin-top: 0;
    margin-bottom: var(--spacing-8);
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
  }

  .author-box p {
    margin: 0;
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-body);
  }
</style>
