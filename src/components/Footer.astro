---
const currentYear = new Date().getFullYear();

const categories = [
  { name: 'AI Tools', href: '/ai-tools' },
  { name: 'Productivity', href: '/productivity' },
  { name: 'Comparisons', href: '/comparisons' },
  { name: 'Automation', href: '/automation' },
  { name: 'Business Software', href: '/business-software' },
  { name: 'Guides', href: '/guides' },
];

const legals = [
  { name: 'About Us', href: '/about' },
  { name: 'Contact', href: '/contact' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Terms of Service', href: '/terms' },
  { name: 'Disclaimer', href: '/disclaimer' },
  { name: 'Cookie Policy', href: '/cookie-policy' },
];
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          Stacked<span class="highlight">Tools</span>
        </a>
        <p class="brand-desc">
          Discover, compare, and master the best digital tools. In-depth reviews, honest comparisons, and actionable guides — zero filler.
        </p>
      </div>

      <div class="footer-col">
        <h4 class="col-title">Categories</h4>
        <ul class="col-list">
          {categories.map(cat => (
            <li><a href={cat.href}>{cat.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title">Company & Legal</h4>
        <ul class="col-list">
          {legals.map(item => (
            <li><a href={item.href}>{item.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-row">
        <p>&copy; {currentYear} StackedTools. All rights reserved.</p>
        <p class="made-by">Made with love by <a href="https://github.com/iiamdark" target="_blank" rel="noopener">iiamdark</a></p>
      </div>
      <p class="affiliate-notice">
        Disclaimer: Some links on this site may be affiliate links. We may earn a commission if you make a purchase through these links at no extra cost to you.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-void);
    border-top: 1px solid var(--border-color);
    padding: var(--spacing-64) 0 var(--spacing-32);
    margin-top: var(--spacing-64);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-40);
    margin-bottom: var(--spacing-40);
  }

  .footer-logo {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: var(--tracking-body-lg);
  }

  .highlight {
    color: var(--color-electric-iris);
  }

  .brand-desc {
    margin-top: var(--spacing-16);
    max-width: 380px;
    font-family: var(--font-inter);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-iron-veil);
    letter-spacing: var(--tracking-body);
  }

  .col-title {
    font-family: var(--font-inter);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-16);
    letter-spacing: var(--tracking-body);
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .col-list a {
    color: var(--text-secondary);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    text-decoration: none;
    transition: color 200ms ease;
    letter-spacing: var(--tracking-body);
  }

  .col-list a:hover {
    color: var(--color-electric-iris);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--spacing-32);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    font-family: var(--font-inter);
    font-size: var(--text-caption);
    color: var(--color-iron-veil);
    line-height: var(--leading-caption);
  }

  .footer-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-8);
  }

  .made-by a {
    color: var(--color-electric-iris);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    transition: color 200ms ease;
  }
  .made-by a:hover {
    color: var(--color-ember-pulse);
  }

  .affiliate-notice {
    font-size: 10px;
    line-height: 1.4;
    color: var(--color-slate-edge);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-32);
    }
  }
</style>
