---
---

<div class="newsletter-cta double-bezel">
  <div class="double-bezel-inner newsletter-inner">
    <div class="newsletter-text">
      <h3>Stay in the loop</h3>
      <p>Get the latest software reviews, comparisons, and productivity tips delivered to your inbox. No spam, unsubscribe anytime.</p>
    </div>
    <form class="newsletter-form" id="newsletter-form">
      <input type="email" name="email" placeholder="your@email.com" required class="newsletter-input" />
      <button type="submit" class="btn-tactile btn-primary-tactile newsletter-btn">
        <span>Subscribe</span>
      </button>
    </form>
    <p class="newsletter-status" id="newsletter-status" hidden></p>
  </div>
</div>

<script is:inline>
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const status = document.getElementById('newsletter-status');
    const btn = form.querySelector('button');
    
    btn.disabled = true;
    btn.querySelector('span').textContent = '...';
    status.hidden = false;
    status.textContent = '';
    status.className = 'newsletter-status';

    try {
      const formData = new FormData(form);
      formData.append('message', 'Newsletter subscription');
      const response = await fetch('https://formspree.io/f/xpznvgar', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        status.textContent = 'Thanks for subscribing!';
        status.className = 'newsletter-status newsletter-success';
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Try again.';
        status.className = 'newsletter-status newsletter-error';
      }
    } catch {
      status.textContent = 'Network error. Try again later.';
      status.className = 'newsletter-status newsletter-error';
    } finally {
      btn.disabled = false;
      btn.querySelector('span').textContent = 'Subscribe';
    }
  });
</script>

<style>
  .newsletter-cta {
    margin: var(--spacing-64) 0;
  }

  .newsletter-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-24);
    padding: var(--spacing-40) var(--spacing-32);
  }

  .newsletter-text h3 {
    font-family: var(--font-inter);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-8);
    letter-spacing: var(--tracking-heading-sm);
  }

  .newsletter-text p {
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--text-secondary);
    max-width: 480px;
    letter-spacing: var(--tracking-body);
  }

  .newsletter-form {
    display: flex;
    gap: var(--spacing-8);
    width: 100%;
    max-width: 440px;
  }

  .newsletter-input {
    flex: 1;
    background: var(--color-void);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-inputs);
    padding: var(--spacing-12) var(--spacing-16);
    color: var(--text-primary);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-electric-iris);
  }

  .newsletter-btn {
    white-space: nowrap;
  }

  .newsletter-status {
    font-family: var(--font-inter);
    font-size: var(--text-body);
  }

  .newsletter-success {
    color: #10b981;
  }

  .newsletter-error {
    color: var(--color-ember-pulse);
  }

  @media (max-width: 640px) {
    .newsletter-form {
      flex-direction: column;
    }
  }
</style>
