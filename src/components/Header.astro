---
import { Bot, Zap, GitCompare, Workflow, Briefcase, BookOpen, ChevronRight, Menu, X } from 'lucide-astro';

const navItems = [
  { name: 'AI Tools', href: '/ai-tools', icon: Bot },
  { name: 'Productivity', href: '/productivity', icon: Zap },
  { name: 'Comparisons', href: '/comparisons', icon: GitCompare },
  { name: 'Automation', href: '/automation', icon: Workflow },
  { name: 'Business', href: '/business-software', icon: Briefcase },
  { name: 'Guides', href: '/guides', icon: BookOpen },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="logo">
      <div class="logo-wrapper">
        <img src="/logo.png" alt="StackedTools Logo" class="logo-img" />
      </div>
      <span class="logo-text">Stacked<span class="highlight">Tools</span></span>
    </a>

    <nav class="desktop-nav">
      {navItems.map(item => {
        const Icon = item.icon;
        return (
          <a href={item.href} class="nav-link">
            <Icon class="nav-icon" />
            <span>{item.name}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-cta">
      <a href="/guides" class="btn-tactile btn-primary-tactile nav-btn">
        <span>Explore Guides</span>
        <div class="btn-icon-wrapper">
          <ChevronRight class="btn-icon" />
        </div>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-backdrop);
    border-bottom: 1px solid var(--border-color);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--spacing-64);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    color: var(--text-primary);
    font-family: var(--font-inter);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-subheading);
    text-decoration: none;
    letter-spacing: var(--tracking-subheading);
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 300ms var(--ease-out-strong);
  }

  .logo:hover .logo-wrapper {
    transform: scale(1.05) rotate(-2deg);
  }

  .logo-img {
    height: 2.25rem;
    width: auto;
    object-fit: contain;
  }

  .highlight {
    color: var(--color-electric-iris);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    background: rgba(255, 255, 255, 0.02);
    padding: 3px var(--spacing-8);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    color: var(--text-secondary);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    padding: var(--spacing-4) var(--spacing-12);
    border-radius: var(--radius-full);
    transition: all 200ms var(--ease-out-strong);
    text-decoration: none;
    letter-spacing: var(--tracking-body);
  }

  .nav-icon {
    width: 14px;
    height: 14px;
    color: var(--color-iron-veil);
    transition: color 200ms var(--ease-out-strong), transform 200ms var(--ease-out-strong);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link:hover .nav-icon {
    color: var(--color-electric-iris);
    transform: translateY(-1px);
  }

  .nav-btn {
    padding: var(--spacing-8) var(--spacing-20);
    font-size: var(--text-caption);
  }

  .btn-icon {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }
  }
</style>
