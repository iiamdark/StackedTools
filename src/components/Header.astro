---
import { BookOpen, Library, Menu, X, Sun, Moon } from 'lucide-astro';

const navItems = [
  { name: 'Blog', href: '/blog', icon: BookOpen },
  { name: 'Recursos', href: '/recursos', icon: Library },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="logo">
      <div class="logo-wrapper">
        <img src="/logo.png" alt="StackedTools Logo" class="logo-img" />
      </div>
      <span class="logo-text">Stacked<span class="highlight">Tools</span></span>
    </a>

    <nav class="desktop-nav">
      {navItems.map(item => {
        const Icon = item.icon;
        return (
          <a href={item.href} class="nav-link">
            <Icon class="nav-icon" />
            <span>{item.name}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <Sun class="theme-icon sun-icon" />
        <Moon class="theme-icon moon-icon" />
      </button>

      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
        <Menu class="menu-icon" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-header">
      <span class="mobile-nav-title">Menu</span>
      <button class="mobile-close-btn" id="mobile-close-btn" aria-label="Close menu">
        <X class="close-icon" />
      </button>
    </div>
    <nav class="mobile-nav-list">
      {navItems.map(item => {
        const Icon = item.icon;
        return (
          <a href={item.href} class="mobile-nav-link">
            <Icon class="mobile-nav-icon" />
            <span>{item.name}</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script is:inline>
  function initTheme() {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = saved || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
    return theme;
  }
  initTheme();

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  document.getElementById('mobile-close-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.remove('open');
    document.body.style.overflow = '';
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobile-nav')?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-backdrop);
    border-bottom: 1px solid var(--border-color);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--spacing-64);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    color: var(--text-primary);
    font-family: var(--font-inter);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-subheading);
    text-decoration: none;
    letter-spacing: var(--tracking-subheading);
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 300ms var(--ease-out-strong);
  }

  .logo:hover .logo-wrapper {
    transform: scale(1.05) rotate(-2deg);
  }

  .logo-img {
    height: 2.25rem;
    width: auto;
    object-fit: contain;
  }

  .highlight {
    color: var(--color-electric-iris);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    background: rgba(255, 255, 255, 0.02);
    padding: 3px var(--spacing-8);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    color: var(--text-secondary);
    font-family: var(--font-inter);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    padding: var(--spacing-4) var(--spacing-12);
    border-radius: var(--radius-full);
    transition: all 200ms var(--ease-out-strong);
    text-decoration: none;
    letter-spacing: var(--tracking-body);
  }

  .nav-icon {
    width: 14px;
    height: 14px;
    color: var(--color-iron-veil);
    transition: color 200ms var(--ease-out-strong), transform 200ms var(--ease-out-strong);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link:hover .nav-icon {
    color: var(--color-electric-iris);
    transform: translateY(-1px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 200ms var(--ease-out-strong);
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border-color: var(--border-color);
  }

  .theme-icon {
    width: 16px;
    height: 16px;
  }

  :global(html[data-theme="dark"]) .sun-icon { display: block; }
  :global(html[data-theme="dark"]) .moon-icon { display: none; }
  :global(html[data-theme="light"]) .sun-icon { display: none; }
  :global(html[data-theme="light"]) .moon-icon { display: block; }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 200ms var(--ease-out-strong);
  }

  .mobile-menu-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
  }

  .menu-icon {
    width: 20px;
    height: 20px;
  }

  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    background: var(--color-void);
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out-strong);
  }

  .mobile-nav.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-16) var(--spacing-24);
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-nav-title {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }

  .mobile-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .close-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-16) var(--spacing-24);
    gap: var(--spacing-4);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-cards);
    color: var(--text-secondary);
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: all 200ms var(--ease-out-strong);
  }

  .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  .mobile-nav-icon {
    width: 18px;
    height: 18px;
    color: var(--color-iron-veil);
  }

  .mobile-nav-link:hover .mobile-nav-icon {
    color: var(--color-electric-iris);
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }

    .nav-btn {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }
  }
</style>
