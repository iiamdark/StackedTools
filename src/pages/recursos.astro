---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookOpen, ExternalLink, Sparkles, Code, Zap, Bot, GraduationCap, FileText, Users, Globe, Terminal, Layers, Mail, Database, GitCompare, Calendar, Shield, BarChart3, Palette, Map, Star, Wrench, Search } from 'lucide-astro';

const categories = [
  {
    name: 'AI & Coding Assistants',
    description: 'AI-powered tools that write, review and ship code alongside you',
    color: '#8b5cf6',
    icon: Bot,
    tools: [
      { name: 'Cursor', desc: 'AI code editor with Composer for multi-file edits and codebase understanding', url: 'https://cursor.com', icon: Terminal, tag: 'AI Editor' },
      { name: 'GitHub Copilot', desc: 'AI pair programmer inline in your editor with chat and code review', url: 'https://github.com/features/copilot', icon: Bot, tag: 'AI Coding' },
      { name: 'OpenAI Codex', desc: 'Command center for controlling AI agents. Work with multiple agents in parallel', url: 'https://openai.com/codex', icon: Bot, tag: 'Agents' },
      { name: 'OpenClaw', desc: 'Personal AI assistant that runs on your devices. Connects with WhatsApp, Telegram, Slack', url: 'https://github.com/openclaw/openclaw', icon: Bot, tag: 'Assistant' },
      { name: 'Spec Kit', desc: 'AI-powered specification-driven development toolkit for Claude Code, Gemini CLI, Codex', url: 'https://speckit.org', icon: Code, tag: 'Specs' },
      { name: 'CodexBar', desc: 'App that shows your AI subscription usage. Compatible with Claude, Gemini, Cursor', url: 'https://github.com/steipete/CodexBar', icon: BarChart3, tag: 'Usage' },
      { name: 'System Prompts Collection', desc: 'Collection of system prompts extracted from ChatGPT, Claude, Gemini and Grok', url: 'https://github.com/asgeirtj/system_prompts_leaks', icon: Search, tag: 'Prompts' },
      { name: 'Cursor Fundamentals', desc: 'Official Cursor course in Spanish. 6 modules covering AI, agents, MCP and more', url: 'https://cursor.com/es/learn', icon: GraduationCap, tag: 'Course' },
      { name: 'Agent Skills with Anthropic', desc: 'Free Anthropic course on Agent Skills. Learn to create skills for Claude Code', url: 'https://www.deeplearning.ai/short-courses/agent-skills-with-anthropic/', icon: GraduationCap, tag: 'Course' },
    ],
  },
  {
    name: 'Development',
    description: 'Core tools and platforms for building modern software',
    color: '#5683da',
    icon: Code,
    tools: [
      { name: 'Vercel', desc: 'Instant deploys for Next.js, Astro, SvelteKit with edge computing', url: 'https://vercel.com', icon: Layers, tag: 'Deploy' },
      { name: 'Supabase', desc: 'Open source backend: PostgreSQL, Auth, Storage, Edge Functions', url: 'https://supabase.com', icon: Database, tag: 'BaaS' },
      { name: 'Linear', desc: 'Fast, minimal issue tracker for engineering teams', url: 'https://linear.app', icon: GitCompare, tag: 'Project Mgmt' },
      { name: 'Railway', desc: 'Fullstack app deploys with managed databases', url: 'https://railway.app', icon: Zap, tag: 'Hosting' },
      { name: 'npkill', desc: 'CLI tool to find and delete unused node_modules folders. Free up gigabytes', url: 'https://npkill.js.org', icon: Wrench, tag: 'CLI' },
      { name: 'Kokonut UI', desc: '100+ open-source animated components built with Tailwind and shadcn/ui', url: 'https://github.com/kokonut-labs/kokonutui', icon: Palette, tag: 'UI Kit' },
    ],
  },
  {
    name: 'Productivity',
    description: 'Organize your work and maximize your time',
    color: '#f59e0b',
    icon: Zap,
    tools: [
      { name: 'Raycast', desc: 'macOS launcher with AI, snippets and extensions', url: 'https://raycast.com', icon: Zap, tag: 'Launcher' },
      { name: 'Notion', desc: 'All-in-one workspace: notes, databases, project management', url: 'https://notion.so', icon: BookOpen, tag: 'Workspace' },
      { name: 'Todoist', desc: 'Task manager with NLP and multiple views', url: 'https://todoist.com', icon: BarChart3, tag: 'Tasks' },
      { name: 'Arc Browser', desc: 'Browser with sidebar, Spaces and built-in AI', url: 'https://arc.net', icon: Globe, tag: 'Browser' },
      { name: '1Password', desc: 'Password manager with passkeys and team sharing', url: 'https://1password.com', icon: Shield, tag: 'Security' },
      { name: 'Cal.com', desc: 'Open source scheduling, self-hosted', url: 'https://cal.com', icon: Calendar, tag: 'Scheduling' },
    ],
  },
  {
    name: 'Automation',
    description: 'Connect your apps and eliminate manual work',
    color: '#10b981',
    icon: Zap,
    tools: [
      { name: 'Zapier', desc: '6,000+ no-code integrations to connect everything', url: 'https://zapier.com', icon: Zap, tag: 'No-Code' },
      { name: 'Make', desc: 'Visual automation platform with complex workflows', url: 'https://make.com', icon: Layers, tag: 'Visual' },
      { name: 'n8n', desc: 'Open source automation, self-hosted', url: 'https://n8n.io', icon: Terminal, tag: 'Open Source' },
      { name: 'Resend', desc: 'Transactional email with modern API and React Email', url: 'https://resend.com', icon: Mail, tag: 'Email' },
      { name: 'Upstash', desc: 'Serverless Redis and QStash for queues', url: 'https://upstash.com', icon: Database, tag: 'Serverless' },
      { name: 'Pipedream', desc: 'Connect APIs with code when you need it', url: 'https://pipedream.com', icon: Code, tag: 'API' },
    ],
  },
  {
    name: 'Learning',
    description: 'Courses, challenges and resources to level up your skills',
    color: '#f472b6',
    icon: GraduationCap,
    tools: [
      { name: 'freeCodeCamp', desc: 'Learn to code for free with professional certifications. 3000+ hours of content', url: 'https://www.freecodecamp.org', icon: GraduationCap, tag: 'Free' },
      { name: 'AdventJS', desc: 'JavaScript, TypeScript and Python advent calendar with daily coding challenges', url: 'https://adventjs.dev', icon: Code, tag: 'Challenges' },
      { name: 'Python MOOC - Helsinki', desc: 'Complete Python course from zero to advanced with official university certificate', url: 'https://programming-24.mooc.fi', icon: GraduationCap, tag: 'Certificate' },
      { name: 'KodeKloud Free Labs', desc: 'Practice Kubernetes, Docker, Terraform in free cloud environments in your browser', url: 'https://kodekloud.com/free-labs/kubernetes', icon: Terminal, tag: 'DevOps' },
      { name: 'JSCamp Bootcamp', desc: 'JavaScript bootcamp exercises from midudev with real projects', url: 'https://github.com/midudev/jscamp', icon: Code, tag: 'Bootcamp' },
      { name: 'NVIDIA Deep Learning', desc: 'Free AI courses by NVIDIA. GenAI, neural networks, LLM agents with certification', url: 'https://www.nvidia.com/en-us/training/', icon: Bot, tag: 'Free' },
      { name: '500+ AI Projects', desc: 'Massive repo with 500 AI, ML, Deep Learning, Computer Vision and NLP projects with code', url: 'https://github.com/ashishpatel26/500-AI-Machine-learning-Deep-learning-Computer-vision-NLP-Projects-with-code', icon: Bot, tag: 'Projects' },
      { name: 'LLM Engineer Toolkit', desc: '120+ curated libraries for AI/LLM organized by development phase', url: 'https://github.com/KalyanKS-NLP/llm-engineer-toolkit', icon: Bot, tag: 'Libraries' },
    ],
  },
  {
    name: 'Documentation',
    description: 'Official docs and references you will actually use',
    color: '#06b6d4',
    icon: FileText,
    tools: [
      { name: 'MDN Web Docs', desc: 'Definitive web docs by Mozilla. HTML, CSS, JavaScript and browser APIs', url: 'https://developer.mozilla.org', icon: FileText, tag: 'Reference' },
      { name: 'React Documentation', desc: 'Official React docs with hooks, Server Components and modern best practices', url: 'https://react.dev', icon: Code, tag: 'Frontend' },
      { name: 'web.dev', desc: 'Google guides, codelabs and best practices for modern web development', url: 'https://web.dev', icon: Globe, tag: 'Google' },
    ],
  },
  {
    name: 'Roadmaps & Career',
    description: 'Visual guides to plan your developer career path',
    color: '#ef4444',
    icon: Map,
    tools: [
      { name: 'Developer Roadmaps', desc: 'Step-by-step visual guides for Frontend, Backend, DevOps and more', url: 'https://roadmap.sh', icon: Map, tag: 'Roadmaps' },
    ],
  },
  {
    name: 'Free Tools & Templates',
    description: 'Free hosting, APIs, templates and developer resources',
    color: '#22c55e',
    icon: Star,
    tools: [
      { name: 'Free for Developers', desc: 'Massive list of free tools: hosting, APIs, databases, CI/CD and more', url: 'https://free-for.dev', icon: Star, tag: 'Free' },
      { name: 'GitHub Student Dev Pack', desc: '$200k+ in free credits and tools for students. Hosting, domains, courses', url: 'https://education.github.com/pack', icon: GraduationCap, tag: 'Students' },
      { name: 'Public APIs', desc: 'Collective list of free public APIs: weather, news, finance, entertainment', url: 'https://github.com/public-apis/public-apis', icon: Globe, tag: 'APIs' },
      { name: 'HTML Templates', desc: '1000+ free HTML templates. Responsive, modern, Bootstrap and Tailwind', url: 'https://htmltemplates.co', icon: Palette, tag: 'Templates' },
      { name: 'UIdeck', desc: '2000+ free HTML templates and UI kits for React, Vue, Astro, Next.js', url: 'https://uideck.com', icon: Palette, tag: 'UI Kit' },
      { name: 'Awesome Lists', desc: 'Meta-list of curated lists on every topic: languages, frameworks, tools', url: 'https://github.com/sindresorhus/awesome', icon: Star, tag: 'Curated' },
    ],
  },
  {
    name: 'Community',
    description: 'Where developers help each other grow',
    color: '#a855f7',
    icon: Users,
    tools: [
      { name: 'Stack Overflow', desc: 'Largest developer Q&A community. Millions of questions and answers', url: 'https://stackoverflow.com', icon: Users, tag: 'Q&A' },
      { name: 'DEV Community', desc: 'Developer community with articles, tutorials and discussions', url: 'https://dev.to', icon: BookOpen, tag: 'Blog' },
    ],
  },
];
---

<BaseLayout
  title="Resources — StackedTools"
  description="Tools, guides and useful resources for developers, creators and productivity teams."
>

  <!-- ============ HERO ============ -->
  <section class="recursos-hero">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-badge anim-fade-up" style="--delay:.1s">
        <Sparkles class="hero-badge-icon" />
        <span>Curated Resources</span>
      </div>
      <h1 class="anim-fade-up" style="--delay:.2s">
        Tools Our Team<br/>
        <span class="hero-gradient">Uses Every Day</span>
      </h1>
      <p class="hero-sub anim-fade-up" style="--delay:.35s">
        Real recommendations, no sponsorships. Every tool has been tested by our team on real projects.
      </p>
      <div class="hero-stats anim-fade-up" style="--delay:.5s">
        <div class="stat-pill"><span class="stat-num">{categories.reduce((a, c) => a + c.tools.length, 0)}</span> Resources</div>
        <div class="stat-pill"><span class="stat-num">{categories.length}</span> Categories</div>
        <div class="stat-pill"><span class="stat-num">100%</span> Tested</div>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORIES ============ -->
  <div class="container recursos-page">
    {categories.map((cat, ci) => {
      const CatIcon = cat.icon;
      return (
        <section class="category-section reveal" style={`--delay:${Math.min(ci * 0.08, 0.3)}s`}>
          <div class="category-header">
            <div class="category-icon-box" style={`--cat-color:${cat.color}`}>
              <CatIcon class="category-icon" />
            </div>
            <div>
              <h2>{cat.name}</h2>
              <p>{cat.description}</p>
            </div>
          </div>
          <div class="tools-grid">
            {cat.tools.map((tool, ti) => {
              const ToolIcon = tool.icon;
              return (
                <a href={tool.url} target="_blank" rel="noopener" class="tool-card" style={`--delay:${ti * 0.04}s; --cat-color:${cat.color}`}>
                  <div class="tool-card-top">
                    <div class="tool-icon-box" style={`--cat-color:${cat.color}`}>
                      <ToolIcon class="tool-icon" />
                    </div>
                    <ExternalLink class="tool-ext" />
                  </div>
                  <div class="tool-tag" style={`--cat-color:${cat.color}`}>{tool.tag}</div>
                  <h3>{tool.name}</h3>
                  <p>{tool.desc}</p>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>

</BaseLayout>

<script is:inline>
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
  }, { threshold: 0.06, rootMargin: '0px 0px -20px 0px' });
  reveals.forEach(el => io.observe(el));
</script>

<style>
  .recursos-hero {
    position: relative; z-index: 1;
    padding: 160px 0 50px; text-align: center; overflow: hidden;
  }
  .hero-bg-glow {
    position: absolute; top: -30%; left: 50%; transform: translateX(-50%);
    width: 800px; height: 450px;
    background: radial-gradient(ellipse, rgba(16,185,129,0.12) 0%, rgba(86,131,218,0.06) 50%, transparent 70%);
    filter: blur(60px); pointer-events: none;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 14px; border-radius: var(--radius-full);
    background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2);
    color: #34d399; font-family: var(--font-inter); font-size: 11px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: var(--spacing-16);
  }
  .hero-badge-icon { width: 12px; height: 12px; }
  .recursos-hero h1 {
    font-family: var(--font-inter); font-weight: 800;
    font-size: clamp(28px, 5vw, 52px); line-height: 1.1;
    letter-spacing: -0.04em; margin-bottom: var(--spacing-12);
  }
  .hero-gradient {
    background: linear-gradient(135deg, #10b981 0%, #5683da 50%, #f59e0b 100%);
    background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    animation: heroGrad 6s ease infinite;
  }
  @keyframes heroGrad { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
  .hero-sub {
    font-family: var(--font-inter); font-size: var(--text-body-lg);
    color: var(--text-secondary); max-width: 520px; margin: 0 auto var(--spacing-20);
  }
  .hero-stats { display: flex; justify-content: center; gap: var(--spacing-8); flex-wrap: wrap; }
  .stat-pill {
    display: flex; align-items: center; gap: 4px;
    padding: 5px 14px; border-radius: var(--radius-full);
    background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);
    font-family: var(--font-inter); font-size: 12px; color: var(--text-secondary);
  }
  .stat-num { font-weight: 700; color: var(--text-primary); }

  .anim-fade-up {
    opacity: 0; transform: translateY(20px);
    animation: fadeUp 0.6s cubic-bezier(0.23,1,0.32,1) forwards;
    animation-delay: var(--delay, 0s);
  }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  .recursos-page { padding-bottom: var(--spacing-160); }

  .category-section { margin-bottom: var(--spacing-56); }
  .category-header {
    display: flex; align-items: center; gap: var(--spacing-16);
    margin-bottom: var(--spacing-24);
  }
  .category-icon-box {
    width: 48px; height: 48px; min-width: 48px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--cat-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 20%, transparent);
    display: flex; align-items: center; justify-content: center;
    color: var(--cat-color);
  }
  .category-icon { width: 24px; height: 24px; }
  .category-header h2 {
    font-family: var(--font-inter); font-size: 22px; font-weight: 700;
    color: var(--text-primary); margin-bottom: 2px; letter-spacing: -0.02em;
  }
  .category-header p {
    font-family: var(--font-inter); font-size: 14px; color: var(--text-secondary); margin: 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-12);
  }
  .tool-card {
    padding: var(--spacing-20);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-cards);
    text-decoration: none;
    display: flex; flex-direction: column;
    transition: all 250ms var(--ease-out-strong);
  }
  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--cat-color);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--cat-color) 10%, transparent);
  }
  .tool-card-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: var(--spacing-12);
  }
  .tool-icon-box {
    width: 40px; height: 40px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--cat-color) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 15%, transparent);
    display: flex; align-items: center; justify-content: center;
    color: var(--cat-color);
  }
  .tool-icon { width: 20px; height: 20px; }
  .tool-ext {
    width: 14px; height: 14px;
    color: var(--color-iron-veil);
    transition: color 200ms ease, transform 200ms ease;
  }
  .tool-card:hover .tool-ext { color: var(--cat-color); transform: translate(2px, -2px); }
  .tool-tag {
    display: inline-block; align-self: flex-start;
    padding: 2px 8px; border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cat-color) 8%, transparent);
    font-family: var(--font-inter); font-size: 10px; font-weight: 600;
    color: var(--cat-color); text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: var(--spacing-8);
  }
  .tool-card h3 {
    font-family: var(--font-inter); font-size: 16px; font-weight: 600;
    color: var(--text-primary); margin-bottom: 4px;
  }
  .tool-card p {
    font-family: var(--font-inter); font-size: 13px; color: var(--text-secondary);
    line-height: 1.5; margin: 0;
  }

  .reveal {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.5s cubic-bezier(0.23,1,0.32,1), transform 0.5s cubic-bezier(0.23,1,0.32,1);
    transition-delay: var(--delay, 0s);
  }
  .reveal.revealed { opacity: 1; transform: translateY(0); }

  @media (max-width: 868px) {
    .recursos-hero { padding: 140px 0 30px; }
    .category-header { flex-direction: column; align-items: flex-start; gap: var(--spacing-12); }
    .tools-grid { grid-template-columns: 1fr; }
  }
</style>
