---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookOpen, ExternalLink, ArrowRight, Search, Zap, Bot } from 'lucide-astro';
---

<BaseLayout
  title="Recursos — StackedTools"
  description="Herramientas, guías y recursos útiles para desarrolladores, creadores y equipos de productividad."
>

  <section class="recursos-hero">
    <div class="container">
      <div class="section-eyebrow">
        <Zap class="eyebrow-icon" />
        <span>Recursos</span>
      </div>
      <h1>Recursos y Herramientas Útiles</h1>
      <p>Compilación de las mejores herramientas, plantillas y guías que nuestro equipo usa y recomienda.</p>
    </div>
  </section>

  <section class="recursos-grid-section">
    <div class="container">

      <div class="resource-category">
        <h2>Desarrollo</h2>
        <div class="resource-list">
          <a href="https://cursor.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Bot class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Cursor</h3>
              <p>AI code editor basado en VS Code con Composer para ediciones multi-archivo.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://vercel.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Vercel</h3>
              <p>Plataforma de deploy para frameworks modernos. Next.js, Astro, SvelteKit.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://supabase.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Supabase</h3>
              <p>Backend-as-a-Service open source con PostgreSQL, Auth, Storage y Edge Functions.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://linear.app" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Linear</h3>
              <p>Issue tracker rápido y minimalista para equipos de ingeniería.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
        </div>
      </div>

      <div class="resource-category">
        <h2>Productividad</h2>
        <div class="resource-list">
          <a href="https://raycast.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Raycast</h3>
              <p>Launcher para macOS con AI integrado, snippets y extensiones.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://notion.so" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><BookOpen class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Notion</h3>
              <p>All-in-one workspace para notas, bases de datos y project management.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://linear.app" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Todoist</h3>
              <p>Gestor de tareas con NLP, vistas múltiples y sincronización cross-platform.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
        </div>
      </div>

      <div class="resource-category">
        <h2>Automatización</h2>
        <div class="resource-list">
          <a href="https://zapier.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Zapier</h3>
              <p>Automatización no-code con 6,000+ integraciones para conectar tus apps.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://make.com" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>Make</h3>
              <p>Plataforma visual de automatización con flujos complejos y lógica condicional.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
          <a href="https://n8n.io" target="_blank" rel="noopener" class="resource-card">
            <div class="resource-icon-box"><Zap class="resource-icon" /></div>
            <div class="resource-info">
              <h3>n8n</h3>
              <p>Automatización open source que puedes self-hostear. Código cuando lo necesites.</p>
            </div>
            <ExternalLink class="resource-arrow" />
          </a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .recursos-hero {
    position: relative;
    z-index: 1;
    padding: 160px 0 60px;
    text-align: center;
  }
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    font-family: var(--font-inter);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-electric-iris);
    margin-bottom: var(--spacing-12);
    font-weight: var(--font-weight-semibold);
  }
  .eyebrow-icon { width: 14px; height: 14px; }
  .recursos-hero h1 {
    font-family: var(--font-inter);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-12);
    letter-spacing: -0.03em;
  }
  .recursos-hero p {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
  }

  .recursos-grid-section {
    position: relative;
    z-index: 1;
    padding: 0 0 var(--spacing-160);
  }

  .resource-category {
    margin-bottom: var(--spacing-48);
  }
  .resource-category h2 {
    font-family: var(--font-inter);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-16);
    color: var(--text-primary);
  }

  .resource-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .resource-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    padding: var(--spacing-16) var(--spacing-20);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-cards);
    text-decoration: none;
    transition: all 250ms var(--ease-out-strong);
  }
  .resource-card:hover {
    border-color: var(--color-electric-iris);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(86, 131, 218, 0.1);
  }

  .resource-icon-box {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: var(--radius-md);
    background: rgba(86, 131, 218, 0.08);
    border: 1px solid rgba(86, 131, 218, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-electric-iris);
  }
  .resource-icon { width: 18px; height: 18px; }

  .resource-info { flex: 1; }
  .resource-info h3 {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 2px;
  }
  .resource-info p {
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--text-secondary);
    margin: 0;
  }

  .resource-arrow {
    width: 16px;
    height: 16px;
    color: var(--color-iron-veil);
    transition: color 200ms var(--ease-out-strong), transform 200ms var(--ease-out-strong);
  }
  .resource-card:hover .resource-arrow {
    color: var(--color-electric-iris);
    transform: translate(2px, -2px);
  }

  @media (max-width: 868px) {
    .recursos-hero { padding: 140px 0 40px; }
  }
</style>
