      { name: 'GitHub Student Dev Pack', desc: '$200k+ in free credits and tools for students. Hosting, domains, courses', url: 'https://education.github.com/pack', tag: 'Students' },
      { name: 'Public APIs', desc: 'Collective list of free public APIs: weather, news, finance, entertainment', url: 'https://github.com/public-apis/public-apis', tag: 'APIs' },
      { name: 'HTML Templates', desc: '1000+ free HTML templates. Responsive, modern, Bootstrap and Tailwind', url: 'https://htmltemplates.co', tag: 'Templates' },
      { name: 'UIdeck', desc: '2000+ free HTML templates and UI kits for React, Vue, Astro, Next.js', url: 'https://uideck.com', tag: 'UI Kit' },
      { name: 'Awesome Lists', desc: 'Meta-list of curated lists on every topic: languages, frameworks, tools', url: 'https://github.com/sindresorhus/awesome', tag: 'Curated' },
