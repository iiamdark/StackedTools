      { name: 'Notion', desc: 'All-in-one workspace: notes, databases, project management', url: 'https://notion.so', tag: 'Workspace' },
      { name: 'Todoist', desc: 'Task manager with NLP and multiple views', url: 'https://todoist.com', tag: 'Tasks' },
      { name: 'Arc Browser', desc: 'Browser with sidebar, Spaces and built-in AI', url: 'https://arc.net', tag: 'Browser' },
