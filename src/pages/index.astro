---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const categories = [
  { name: 'AI Tools', slug: 'ai-tools', desc: 'Reviews & comparisons of cutting-edge AI software', icon: '🤖', badge: 'Popular' },
  { name: 'Productivity', slug: 'productivity', desc: 'Task management, note-taking & workflow systems', icon: '⚡', badge: 'High CPC' },
  { name: 'Comparisons', slug: 'comparisons', desc: 'Head-to-head software showdowns and alternatives', icon: '⚔️', badge: 'Buying Intent' },
  { name: 'Automation', slug: 'automation', desc: 'No-code tools, API integrations & automated workflows', icon: '🔄', badge: 'Trending' },
  { name: 'Business Software', slug: 'business-software', desc: 'CRMs, email marketing & business operations', icon: '💼', badge: 'B2B' },
  { name: 'Guides & Tutorials', slug: 'guides', desc: 'Actionable walkthroughs and step-by-step masterclasses', icon: '📚', badge: 'How-To' },
];
---

<BaseLayout
  title="StackedTools — Discover, Compare & Master the Best Digital Tools"
  description="In-depth reviews, honest software comparisons, and actionable productivity guides. Zero filler, real data."
>
  {/* Hero Section */}
  <section class="hero-section">
    <div class="container">
      <div class="hero-badge">
        <span class="badge badge-purple">✨ StackedTools Portal</span>
      </div>
      <h1 class="hero-title">
        Discover, Compare & Master <br />
        <span class="hero-gradient">The Best Digital Tools</span>
      </h1>
      <p class="hero-subtitle">
        In-depth reviews, head-to-head comparisons, and no-code automation guides for modern creators, freelancers, and growth teams.
      </p>
      
      <div class="hero-actions">
        <a href="#categories" class="btn-tactile btn-primary-tactile">
          <span>Explore Categories</span>
          <div class="btn-icon-wrapper">↓</div>
        </a>
        <a href="/about" class="btn-tactile btn-secondary-tactile">
          <span>Editorial Standards</span>
          <div class="btn-icon-wrapper">→</div>
        </a>
      </div>
    </div>
  </section>

  {/* Categories Grid Section */}
  <section id="categories" class="categories-section">
    <div class="container">
      <div class="section-header">
        <h2>Browse by Category</h2>
        <p>Explore our curated silos of software reviews and technical breakdowns.</p>
      </div>

      <div class="category-grid">
        {categories.map((cat) => (
          <div class="double-bezel">
            <a href={`/${cat.slug}`} class="cat-card double-bezel-inner">
              <div class="cat-top">
                <span class="cat-icon">{cat.icon}</span>
                <span class="badge">{cat.badge}</span>
              </div>
              <h3>{cat.name}</h3>
              <p>{cat.desc}</p>
              <div class="cat-link">
                <span>View tools</span>
                <span class="arrow">↗</span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Articles Section */}
  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <h2>Latest Articles & Reviews</h2>
        <p>Fresh insights verified by our software editorial team.</p>
      </div>

      <div class="posts-grid">
        {posts.map((post) => (
          <div class="double-bezel">
            <article class="article-card double-bezel-inner">
              <a href={`/blog/${post.slug}/`}>
                <div class="card-meta">
                  <span class="badge badge-purple">{post.data.category || 'Review'}</span>
                  <time>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <span class="author">By {post.data.author || 'StackedTools Team'}</span>
                  <span class="read-link">Read post &rarr;</span>
                </div>
              </a>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 6rem 0 5rem;
    text-align: center;
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 1.25rem;
  }

  .hero-gradient {
    background: linear-gradient(135deg, #ffffff 0%, var(--accent-blue) 50%, var(--accent-purple) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2.75rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }

  /* Section Common */
  .section-header {
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--text-secondary);
  }

  /* Categories Grid */
  .categories-section {
    padding: 5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .cat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .cat-icon {
    font-size: 2.25rem;
  }

  .cat-card h3 {
    font-size: 1.35rem;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }

  .cat-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
    line-height: 1.5;
  }

  .cat-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    transition: gap 200ms var(--ease-out-strong);
  }

  .cat-card:hover .cat-link {
    gap: 0.625rem;
  }

  /* Posts Section */
  .posts-section {
    padding: 5rem 0 7rem;
    border-top: 1px solid var(--border-subtle);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .article-card a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .article-card h3 {
    font-size: 1.35rem;
    margin: 0 0 0.75rem 0;
    color: var(--text-primary);
  }

  .article-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    font-size: 0.8125rem;
  }

  .author {
    color: var(--text-muted);
  }

  .read-link {
    color: var(--accent-purple);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
    }
  }
</style>
