---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BookOpen, ArrowRight, Clock, Tag, Sparkles, Filter, Search, X } from 'lucide-astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
  { name: 'Todos', slug: 'all', color: '#5683da' },
  { name: 'Herramientas IA', slug: 'ai-tools', color: '#8b5cf6' },
  { name: 'Comparaciones', slug: 'comparisons', color: '#5683da' },
  { name: 'Productividad', slug: 'productivity', color: '#f59e0b' },
  { name: 'Automatización', slug: 'automation', color: '#10b981' },
  { name: 'Guías', slug: 'guides', color: '#f472b6' },
  { name: 'Empresarial', slug: 'business-software', color: '#ef4444' },
];

const categoryColors: Record<string, string> = {
  'ai-tools': '#8b5cf6',
  'comparisons': '#5683da',
  'productivity': '#f59e0b',
  'automation': '#10b981',
  'guides': '#f472b6',
  'business-software': '#ef4444',
};

function estimateReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(3, Math.round(words / 200));
}

const posts = allPosts.map(p => ({
  ...p,
  readingTime: estimateReadingTime(p.body || ''),
}));
---

<BaseLayout title="Blog — StackedTools" description="Análisis profundos de software, comparaciones honestas y guías prácticas. Sin relleno, con datos reales.">

  <section class="blog-hero">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-badge anim-fade-up" style="--delay:.1s">
        <Sparkles class="hero-badge-icon" />
        <span>Blog y Reseñas</span>
      </div>
      <h1 class="anim-fade-up" style="--delay:.2s">Reseñas de Software que<br/><span class="hero-gradient">Realmente Te Ayudan a Decidir</span></h1>
      <p class="hero-sub anim-fade-up" style="--delay:.35s">Comparaciones y guías honestas, basadas en datos. Sin IA genérica, sin rankings patrocinados.</p>
      <div class="blog-stats anim-fade-up" style="--delay:.5s">
        <div class="stat-pill"><span class="stat-num" id="post-count">{allPosts.length}</span> Artículos</div>
        <div class="stat-pill"><span class="stat-num">6</span> Categorías</div>
        <div class="stat-pill"><span class="stat-num">2026</span> Actualizado</div>
      </div>
    </div>
  </section>

  <div class="container blog-page">

    <div class="search-bar reveal">
      <Search class="search-icon" />
      <input type="text" id="blog-search" placeholder="Buscar artículos..." class="search-input" />
      <button id="search-clear" class="search-clear" style="display:none" aria-label="Limpiar búsqueda">
        <X class="clear-icon" />
      </button>
    </div>

    <div class="filter-bar reveal">
      <Filter class="filter-icon" />
      <div class="filter-pills" id="filter-pills">
        {categories.map(cat => (
          <button class="filter-pill" data-cat={cat.slug} style={`--pill-color:${cat.color}`}>
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <div class="posts-grid" id="posts-grid">
      {posts.map((post, i) => (
        <a href={`/es/blog/${post.id}/`} class="post-card" data-cat={post.data.category} data-title={post.data.title.toLowerCase()} data-desc={post.data.description.toLowerCase()}>
          <div class="post-card-inner">
            <div class="post-card-visual">
              <div class="post-visual-glow" style={`--cat-color:${categoryColors[post.data.category] || '#5683da'}`}></div>
              <BookOpen class="post-visual-icon" />
            </div>
            <div class="post-card-body">
              <div class="post-card-top">
                <span class="cat-badge" style={`--cat-color:${categoryColors[post.data.category] || '#5683da'}`}>
                  {(post.data.category || 'Review').replace('-', ' ')}
                </span>
                <span class="reading-time"><Clock class="rt-icon" /> {post.readingTime} min</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="post-card-footer">
                <time>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}</time>
                <span class="read-cta">Leer <ArrowRight class="cta-arrow" /></span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty-state" style="display:none">
      <Search class="empty-icon" />
      <h3>No se encontraron artículos</h3>
      <p>Intenta con otro término de búsqueda o categoría.</p>
      <button class="clear-filters-btn" id="clear-filters">Limpiar filtros</button>
    </div>

  </div>

<script is:inline>
  const pills = document.querySelectorAll('#filter-pills .filter-pill');
  const grid = document.getElementById('posts-grid');
  const allCards = grid ? grid.querySelectorAll('.post-card') : [];
  const emptyState = document.getElementById('empty-state');
  const searchInput = document.getElementById('blog-search');
  const searchClear = document.getElementById('search-clear');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const postCount = document.getElementById('post-count');

  let activeCat = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    allCards.forEach(card => {
      const cat = card.dataset.cat || '';
      const title = (card.dataset.title || '').toLowerCase();
      const desc = (card.dataset.desc || '').toLowerCase();
      const matchesCat = activeCat === 'all' || cat === activeCat;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);
      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });
    if (emptyState) emptyState.style.display = visible === 0 ? '' : 'none';
    if (postCount) postCount.textContent = String(visible);
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = pill.dataset.cat || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      if (searchClear) searchClear.style.display = searchQuery ? '' : 'none';
      applyFilters();
    });
  }

  if (searchClear) {
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      searchClear.style.display = 'none';
      applyFilters();
    });
  }

  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      activeCat = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (searchClear) searchClear.style.display = 'none';
      pills.forEach(p => p.classList.remove('active'));
      const allPill = document.querySelector('[data-cat="all"]');
      if (allPill) allPill.classList.add('active');
      applyFilters();
    });
  }
</script>

</BaseLayout>

<style>
  .blog-hero { position: relative; z-index: 1; padding: 160px 0 40px; text-align: center; overflow: hidden; }
  .hero-bg-glow { position: absolute; top: -30%; left: 50%; transform: translateX(-50%); width: 700px; height: 400px; background: radial-gradient(ellipse, rgba(86,131,218,0.15) 0%, rgba(139,92,246,0.06) 50%, transparent 70%); filter: blur(60px); pointer-events: none; }
  .hero-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: var(--radius-full); background: rgba(139,92,246,0.08); border: 1px solid rgba(139,92,246,0.2); color: #a78bfa; font-family: var(--font-inter); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--spacing-16); }
  .hero-badge-icon { width: 12px; height: 12px; }
  .blog-hero h1 { font-family: var(--font-inter); font-weight: 800; font-size: clamp(28px, 5vw, 52px); line-height: 1.1; letter-spacing: -0.04em; margin-bottom: var(--spacing-12); }
  .hero-gradient { background: linear-gradient(135deg, #8b5cf6 0%, var(--color-electric-iris) 50%, var(--color-ember-pulse) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: heroGrad 6s ease infinite; }
  @keyframes heroGrad { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
  .hero-sub { font-family: var(--font-inter); font-size: var(--text-body-lg); color: var(--text-secondary); max-width: 500px; margin: 0 auto var(--spacing-20); }
  .blog-stats { display: flex; justify-content: center; gap: var(--spacing-8); flex-wrap: wrap; }
  .stat-pill { display: flex; align-items: center; gap: 4px; padding: 5px 14px; border-radius: var(--radius-full); background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); font-family: var(--font-inter); font-size: 12px; color: var(--text-secondary); }
  .stat-num { font-weight: 700; color: var(--text-primary); }

  .anim-fade-up { opacity: 0; transform: translateY(20px); animation: fadeUp 0.6s cubic-bezier(0.23,1,0.32,1) forwards; animation-delay: var(--delay, 0s); }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  .blog-page { padding-bottom: var(--spacing-160); }

  .search-bar { display: flex; align-items: center; gap: var(--spacing-10); margin-bottom: var(--spacing-16); padding: var(--spacing-10) var(--spacing-16); background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: var(--radius-cards); transition: border-color 200ms ease; }
  .search-bar:focus-within { border-color: var(--color-electric-iris); }
  .search-icon { width: 18px; height: 18px; color: var(--color-iron-veil); min-width: 18px; }
  .search-input { flex: 1; background: none; border: none; outline: none; font-family: var(--font-inter); font-size: var(--text-body); color: var(--text-primary); }
  .search-input::placeholder { color: var(--color-iron-veil); }
  .search-clear { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: var(--radius-full); background: rgba(255,255,255,0.05); border: none; color: var(--text-secondary); cursor: pointer; transition: all 200ms ease; }
  .search-clear:hover { background: rgba(255,255,255,0.1); color: var(--text-primary); }
  .clear-icon { width: 14px; height: 14px; }

  .filter-bar { display: flex; align-items: center; gap: var(--spacing-12); margin-bottom: var(--spacing-32); padding: var(--spacing-8) var(--spacing-12); background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-cards); }
  .filter-icon { width: 16px; height: 16px; color: var(--color-iron-veil); min-width: 16px; }
  .filter-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-pill { padding: 6px 14px; border-radius: var(--radius-full); background: transparent; border: 1px solid var(--border-subtle); color: var(--text-secondary); font-family: var(--font-inter); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 200ms ease; }
  .filter-pill:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); border-color: var(--border-color); }
  .filter-pill.active { background: var(--pill-color, var(--color-electric-iris)); color: #fff; border-color: var(--pill-color, var(--color-electric-iris)); }

  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--spacing-16); }
  .post-card { text-decoration: none; }
  .post-card-inner { display: grid; grid-template-columns: 120px 1fr; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-cards); overflow: hidden; transition: all 250ms var(--ease-out-strong); }
  .post-card:hover .post-card-inner { transform: translateY(-4px); border-color: var(--color-electric-iris); box-shadow: 0 12px 32px rgba(86,131,218,0.1); }
  .post-card-visual { position: relative; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.02); border-right: 1px solid var(--border-subtle); }
  .post-visual-glow { position: absolute; width: 60px; height: 60px; border-radius: 50%; background: var(--cat-color); opacity: 0.12; filter: blur(24px); }
  .post-visual-icon { width: 32px; height: 32px; color: var(--cat-color, var(--color-electric-iris)); opacity: 0.4; position: relative; }

  .post-card-body { padding: var(--spacing-20); display: flex; flex-direction: column; }
  .post-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-10); }
  .cat-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: var(--radius-full); background: color-mix(in srgb, var(--cat-color) 12%, transparent); border: 1px solid color-mix(in srgb, var(--cat-color) 25%, transparent); color: var(--cat-color); font-family: var(--font-inter); font-size: 11px; font-weight: 600; text-transform: capitalize; letter-spacing: 0.03em; }
  .reading-time { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-inter); font-size: 12px; color: var(--color-iron-veil); }
  .rt-icon { width: 12px; height: 12px; }
  .post-card-body h3 { font-family: var(--font-inter); font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-6); line-height: 1.35; letter-spacing: -0.01em; }
  .post-card-body p { font-family: var(--font-inter); font-size: 13px; color: var(--text-secondary); line-height: 1.5; flex: 1; margin-bottom: var(--spacing-10); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: var(--spacing-8); border-top: 1px solid var(--border-subtle); font-family: var(--font-inter); font-size: 12px; color: var(--color-iron-veil); }
  .read-cta { display: flex; align-items: center; gap: 4px; color: var(--color-electric-iris); font-weight: 600; }
  .cta-arrow { width: 12px; height: 12px; transition: transform 200ms ease; }
  .post-card:hover .cta-arrow { transform: translateX(3px); }

  .empty-state { text-align: center; padding: var(--spacing-64) 0; color: var(--text-secondary); }
  .empty-icon { width: 48px; height: 48px; margin-bottom: var(--spacing-12); opacity: 0.3; }
  .empty-state h3 { font-family: var(--font-inter); font-size: 18px; margin-bottom: 6px; color: var(--text-primary); }
  .empty-state p { font-family: var(--font-inter); font-size: 14px; margin-bottom: var(--spacing-16); }
  .clear-filters-btn { padding: 8px 20px; border-radius: var(--radius-full); background: var(--color-electric-iris); color: #fff; border: none; font-family: var(--font-inter); font-size: 13px; font-weight: 600; cursor: pointer; transition: all 200ms ease; }
  .clear-filters-btn:hover { opacity: 0.9; transform: translateY(-1px); }

  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.5s cubic-bezier(0.23,1,0.32,1), transform 0.5s cubic-bezier(0.23,1,0.32,1); transition-delay: var(--delay, 0s); }
  .reveal.revealed { opacity: 1; transform: translateY(0); }

  @media (max-width: 868px) { .blog-hero { padding: 140px 0 30px; } .posts-grid { grid-template-columns: 1fr; } .post-card-inner { grid-template-columns: 80px 1fr; } }
  @media (max-width: 480px) { .post-card-visual { display: none; } .post-card-inner { grid-template-columns: 1fr; } }
</style>
