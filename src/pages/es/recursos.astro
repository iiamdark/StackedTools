function getFaviconUrl(url: string): string {
  try {
    const domain = new URL(url).hostname;
    return `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
  } catch {
    return '';
  }
}
---

<BaseLayout
  title="Recursos — StackedTools"
  description="Herramientas, guías y recursos útiles para desarrolladores, creadores y equipos de productividad."
>

  <section class="recursos-hero">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-badge anim-fade-up" style="--delay:.1s">
        <Sparkles class="hero-badge-icon" />
        <span>Recursos Curados</span>
      </div>
      <h1 class="anim-fade-up" style="--delay:.2s">
        Herramientas que Nuestro Equipo<br/>
        <span class="hero-gradient">Usa Cada Día</span>
      </h1>
      <p class="hero-sub anim-fade-up" style="--delay:.35s">
        Recomendaciones reales, sin patrocinios. Cada herramienta ha sido probada por nuestro equipo en proyectos reales.
      </p>
      <div class="hero-stats anim-fade-up" style="--delay:.5s">
        <div class="stat-pill"><span class="stat-num">{categories.reduce((a, c) => a + c.tools.length, 0)}</span> Recursos</div>
        <div class="stat-pill"><span class="stat-num">{categories.length}</span> Categorías</div>
        <div class="stat-pill"><span class="stat-num">100%</span> Probado</div>
      </div>
    </div>
  </section>

  <div class="container recursos-page">

    <div class="search-bar reveal">
      <Search class="search-icon" />
      <input type="text" id="resource-search" placeholder="Buscar herramientas..." class="search-input" />
      <button id="search-clear" class="search-clear" style="display:none" aria-label="Limpiar búsqueda">
        <X class="clear-icon" />
      </button>
    </div>

    <div class="filter-bar reveal">
      <div class="filter-pills" id="filter-pills">
        <button class="filter-pill active" data-cat="all" style="--pill-color:#5683da">Todas</button>
        {categories.map(cat => (
          <button class="filter-pill" data-cat={cat.slug} style={`--pill-color:${cat.color}`}>
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <p class="results-count" id="results-count"></p>

    {categories.map((cat, ci) => (
      <section class="category-section" data-category={cat.slug}>
        <div class="category-header">
          <div class="category-icon-box" style={`--cat-color:${cat.color}`}>
            <span class="category-dot" style={`background:${cat.color}`}></span>
          </div>
          <div>
            <h2>{cat.name}</h2>
            <p class="category-count">{cat.tools.length} herramientas</p>
          </div>
        </div>
        <div class="tools-grid">
          {cat.tools.map((tool) => (
            <a href={tool.url} target="_blank" rel="noopener" class="tool-card" data-name={tool.name.toLowerCase()} data-desc={tool.desc.toLowerCase()} data-tag={tool.tag.toLowerCase()}>
              <div class="tool-card-top">
                <img src={getFaviconUrl(tool.url)} alt="" class="tool-logo" width="32" height="32" loading="lazy" onerror="this.style.display='none'" />
                <ExternalLink class="tool-ext" />
              </div>
              <div class="tool-tag" style={`--cat-color:${cat.color}`}>{tool.tag}</div>
              <h3>{tool.name}</h3>
              <p>{tool.desc}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="empty-state" id="empty-state" style="display:none">
      <Search class="empty-icon" />
      <h3>No se encontraron herramientas</h3>
      <p>Intenta con otro término de búsqueda o categoría.</p>
      <button class="clear-filters-btn" id="clear-filters">Limpiar filtros</button>
    </div>

  </div>

</BaseLayout>

<script is:inline>
  const pills = document.querySelectorAll('#filter-pills .filter-pill');
  const categorySections = document.querySelectorAll('.category-section');
  const searchInput = document.getElementById('resource-search');
  const searchClear = document.getElementById('search-clear');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const emptyState = document.getElementById('empty-state');
  const resultsCount = document.getElementById('results-count');

  let activeCat = 'all';
  let searchQuery = '';

  function applyFilters() {
    let totalVisible = 0;
    let totalTools = 0;

    categorySections.forEach(section => {
      const catSlug = section.dataset.category || '';
      const matchesCat = activeCat === 'all' || catSlug === activeCat;

      if (!matchesCat) { section.style.display = 'none'; return; }

      const cards = section.querySelectorAll('.tool-card');
      let sectionVisible = 0;

      cards.forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const desc = (card.dataset.desc || '').toLowerCase();
        const tag = (card.dataset.tag || '').toLowerCase();
        const matchesSearch = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery) || tag.includes(searchQuery);
        if (matchesSearch) { card.style.display = ''; sectionVisible++; } else { card.style.display = 'none'; }
      });

      section.style.display = sectionVisible > 0 ? '' : 'none';
      totalVisible += sectionVisible;
      totalTools += cards.length;
    });

    if (emptyState) emptyState.style.display = totalVisible === 0 ? '' : 'none';
    if (resultsCount) {
      resultsCount.textContent = (searchQuery || activeCat !== 'all') ? `Mostrando ${totalVisible} de ${totalTools} herramientas` : '';
    }
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = pill.dataset.cat || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      if (searchClear) searchClear.style.display = searchQuery ? '' : 'none';
      applyFilters();
    });
  }

  if (searchClear) {
    searchClear.addEventListener('click', () => { searchInput.value = ''; searchQuery = ''; searchClear.style.display = 'none'; applyFilters(); });
  }

  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      activeCat = 'all'; searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (searchClear) searchClear.style.display = 'none';
      pills.forEach(p => p.classList.remove('active'));
      const allPill = document.querySelector('[data-cat="all"]');
      if (allPill) allPill.classList.add('active');
      applyFilters();
    });
  }
</script>

<style>
  .recursos-hero { position: relative; z-index: 1; padding: 160px 0 50px; text-align: center; overflow: hidden; }
  .hero-bg-glow { position: absolute; top: -30%; left: 50%; transform: translateX(-50%); width: 800px; height: 450px; background: radial-gradient(ellipse, rgba(16,185,129,0.12) 0%, rgba(86,131,218,0.06) 50%, transparent 70%); filter: blur(60px); pointer-events: none; }
  .hero-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: var(--radius-full); background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); color: #34d399; font-family: var(--font-inter); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--spacing-16); }
  .hero-badge-icon { width: 12px; height: 12px; }
  .recursos-hero h1 { font-family: var(--font-inter); font-weight: 800; font-size: clamp(28px, 5vw, 52px); line-height: 1.1; letter-spacing: -0.04em; margin-bottom: var(--spacing-12); }
  .hero-gradient { background: linear-gradient(135deg, #10b981 0%, #5683da 50%, #f59e0b 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: heroGrad 6s ease infinite; }
  @keyframes heroGrad { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
  .hero-sub { font-family: var(--font-inter); font-size: var(--text-body-lg); color: var(--text-secondary); max-width: 520px; margin: 0 auto var(--spacing-20); }
  .hero-stats { display: flex; justify-content: center; gap: var(--spacing-8); flex-wrap: wrap; }
  .stat-pill { display: flex; align-items: center; gap: 4px; padding: 5px 14px; border-radius: var(--radius-full); background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); font-family: var(--font-inter); font-size: 12px; color: var(--text-secondary); }
  .stat-num { font-weight: 700; color: var(--text-primary); }

  .anim-fade-up { opacity: 0; transform: translateY(20px); animation: fadeUp 0.6s cubic-bezier(0.23,1,0.32,1) forwards; animation-delay: var(--delay, 0s); }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  .recursos-page { padding-bottom: var(--spacing-160); }

  .search-bar { display: flex; align-items: center; gap: var(--spacing-10); margin-bottom: var(--spacing-16); padding: var(--spacing-10) var(--spacing-16); background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: var(--radius-cards); transition: border-color 200ms ease; }
  .search-bar:focus-within { border-color: var(--color-electric-iris); }
  .search-icon { width: 18px; height: 18px; color: var(--color-iron-veil); min-width: 18px; }
  .search-input { flex: 1; background: none; border: none; outline: none; font-family: var(--font-inter); font-size: var(--text-body); color: var(--text-primary); }
  .search-input::placeholder { color: var(--color-iron-veil); }
  .search-clear { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: var(--radius-full); background: rgba(255,255,255,0.05); border: none; color: var(--text-secondary); cursor: pointer; transition: all 200ms ease; }
  .search-clear:hover { background: rgba(255,255,255,0.1); color: var(--text-primary); }
  .clear-icon { width: 14px; height: 14px; }

  .filter-bar { margin-bottom: var(--spacing-24); }
  .filter-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-pill { padding: 7px 16px; border-radius: var(--radius-full); background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); color: var(--text-secondary); font-family: var(--font-inter); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 200ms ease; }
  .filter-pill:hover { background: rgba(255,255,255,0.06); color: var(--text-primary); border-color: var(--border-color); }
  .filter-pill.active { background: var(--pill-color, var(--color-electric-iris)); color: #fff; border-color: var(--pill-color, var(--color-electric-iris)); }

  .results-count { font-family: var(--font-inter); font-size: 13px; color: var(--color-iron-veil); margin-bottom: var(--spacing-24); }

  .category-section { margin-bottom: var(--spacing-48); }
  .category-header { display: flex; align-items: center; gap: var(--spacing-12); margin-bottom: var(--spacing-20); padding-bottom: var(--spacing-12); border-bottom: 1px solid var(--border-subtle); }
  .category-icon-box { width: 40px; height: 40px; min-width: 40px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--cat-color) 10%, transparent); border: 1px solid color-mix(in srgb, var(--cat-color) 20%, transparent); display: flex; align-items: center; justify-content: center; }
  .category-dot { width: 12px; height: 12px; border-radius: 50%; }
  .category-header h2 { font-family: var(--font-inter); font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 0; letter-spacing: -0.02em; }
  .category-count { font-family: var(--font-inter); font-size: 13px; color: var(--color-iron-veil); margin: 2px 0 0; }

  .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--spacing-12); }
  .tool-card { padding: var(--spacing-20); background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-cards); text-decoration: none; display: flex; flex-direction: column; transition: all 250ms var(--ease-out-strong); }
  .tool-card:hover { transform: translateY(-4px); border-color: var(--color-electric-iris); box-shadow: 0 12px 32px rgba(86,131,218,0.08); }
  .tool-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--spacing-10); }
  .tool-logo { width: 32px; height: 32px; border-radius: var(--radius-sm); object-fit: contain; background: rgba(255,255,255,0.05); padding: 4px; }
  .tool-ext { width: 14px; height: 14px; color: var(--color-iron-veil); transition: color 200ms ease, transform 200ms ease; }
  .tool-card:hover .tool-ext { color: var(--color-electric-iris); transform: translate(2px, -2px); }
  .tool-tag { display: inline-block; align-self: flex-start; padding: 2px 8px; border-radius: var(--radius-full); background: color-mix(in srgb, var(--cat-color) 8%, transparent); font-family: var(--font-inter); font-size: 10px; font-weight: 600; color: var(--cat-color); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--spacing-8); }
  .tool-card h3 { font-family: var(--font-inter); font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
  .tool-card p { font-family: var(--font-inter); font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin: 0; }

  .empty-state { text-align: center; padding: var(--spacing-64) 0; color: var(--text-secondary); }
  .empty-icon { width: 48px; height: 48px; margin-bottom: var(--spacing-12); opacity: 0.3; }
  .empty-state h3 { font-family: var(--font-inter); font-size: 18px; margin-bottom: 6px; color: var(--text-primary); }
  .empty-state p { font-family: var(--font-inter); font-size: 14px; margin-bottom: var(--spacing-16); }
  .clear-filters-btn { padding: 8px 20px; border-radius: var(--radius-full); background: var(--color-electric-iris); color: #fff; border: none; font-family: var(--font-inter); font-size: 13px; font-weight: 600; cursor: pointer; transition: all 200ms ease; }
