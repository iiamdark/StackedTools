---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin — StackedTools" description="Content management dashboard">

  <!-- LOGIN GATE -->
  <div id="login-screen" class="login-screen">
    <div class="login-bg-glow"></div>
    <div class="login-card">
      <div class="login-logo">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
          <rect width="40" height="40" rx="10" fill="#5683da" fill-opacity="0.15"/>
          <path d="M12 14h6v2h-6v-2zm0 4h10v2H12v-2zm0 4h8v2h-8v-2zm14-6l4 4-4 4v-3h-6v-2h6v-3z" fill="#5683da"/>
        </svg>
      </div>
      <h1 class="login-title">StackedTools</h1>
      <p class="login-subtitle">Admin Dashboard</p>
      <form id="login-form" class="login-form" onsubmit="return false">
        <div class="login-field">
          <label class="login-label" for="login-email">Email</label>
          <input type="email" id="login-email" placeholder="admin@stackedtools.com" class="login-input" autocomplete="email" />
        </div>
        <div class="login-field">
          <label class="login-label" for="login-password">Password</label>
          <input type="password" id="login-password" placeholder="Enter password" class="login-input" autocomplete="current-password" />
        </div>
        <button id="login-btn" class="login-btn" type="submit">
          <span class="login-btn-text">Sign In</span>
          <span class="login-btn-loading" style="display:none">
            <svg class="login-spinner" width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="28" stroke-dashoffset="8"/></svg>
            Signing in...
          </span>
        </button>
      </form>
      <p id="login-error" class="login-error" style="display:none"></p>
      <div class="login-footer">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        <span>Secured with Supabase Auth</span>
      </div>
    </div>
  </div>

  <!-- ADMIN DASHBOARD -->
  <div id="admin-app" class="admin-app" style="display:none">

    <!-- TOP BAR -->
    <div class="admin-topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <h1>Content Manager</h1>
          <span class="topbar-count" id="post-count">0 articles</span>
        </div>
        <div class="topbar-right">
          <span class="saved-indicator" id="saved-indicator" style="display:none">Changes saved locally</span>
          <button class="topbar-btn" id="new-post-btn">+ New Post</button>
          <button class="topbar-btn" id="export-all-btn">Export All Modified</button>
          <button class="topbar-btn topbar-btn-outline" id="logout-btn">Logout</button>
        </div>
      </div>
    </div>

    <div class="container admin-body">

      <!-- STATS -->
      <div class="admin-stats" id="admin-stats">
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-total">0</span>
          <span class="admin-stat-label">Total Articles</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-ai">0</span>
          <span class="admin-stat-label">AI Tools</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-comparisons">0</span>
          <span class="admin-stat-label">Comparisons</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-productivity">0</span>
          <span class="admin-stat-label">Productivity</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-automation">0</span>
          <span class="admin-stat-label">Automation</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-modified">0</span>
          <span class="admin-stat-label">Modified</span>
        </div>
      </div>

      <!-- SEARCH + FILTERS -->
      <div class="admin-toolbar">
        <div class="admin-search">
          <svg class="admin-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="admin-search" placeholder="Search articles..." class="admin-search-input" />
        </div>
        <div class="admin-filters" id="admin-filters">
          <button class="admin-filter-pill active" data-cat="all">All</button>
          <button class="admin-filter-pill" data-cat="ai-tools">AI Tools</button>
          <button class="admin-filter-pill" data-cat="comparisons">Comparisons</button>
          <button class="admin-filter-pill" data-cat="productivity">Productivity</button>
          <button class="admin-filter-pill" data-cat="automation">Automation</button>
          <button class="admin-filter-pill" data-cat="guides">Guides</button>
          <button class="admin-filter-pill" data-cat="business-software">Business</button>
        </div>
      </div>

      <!-- POSTS TABLE -->
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="th-title">Title</th>
              <th class="th-category">Category</th>
              <th class="th-date">Date</th>
              <th class="th-published">Published</th>
              <th class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="posts-tbody"></tbody>
        </table>
      </div>

      <!-- EMPTY STATE -->
      <div class="admin-empty" id="admin-empty" style="display:none">
        <p>No articles match your search.</p>
      </div>
    </div>
  </div>

  <!-- EDIT MODAL -->
  <div id="edit-modal" class="edit-modal" style="display:none">
    <div class="edit-overlay" id="edit-overlay"></div>
    <div class="edit-panel">
      <div class="edit-panel-header">
        <h2>Edit Article</h2>
        <button class="edit-close" id="edit-close" aria-label="Close">&times;</button>
      </div>
      <div class="edit-panel-body">
        <div class="edit-field">
          <label>Title</label>
          <input type="text" id="edit-title" class="edit-input" />
        </div>
        <div class="edit-field">
          <label>Description</label>
          <textarea id="edit-desc" class="edit-textarea" rows="3"></textarea>
        </div>
        <div class="edit-row">
          <div class="edit-field">
            <label>Category</label>
            <select id="edit-category" class="edit-select">
              <option value="ai-tools">AI Tools</option>
              <option value="comparisons">Comparisons</option>
              <option value="productivity">Productivity</option>
              <option value="automation">Automation</option>
              <option value="guides">Guides</option>
              <option value="business-software">Business Software</option>
            </select>
          </div>
          <div class="edit-field">
            <label>Author</label>
            <input type="text" id="edit-author" class="edit-input" />
          </div>
        </div>
        <div class="edit-field">
          <label>Publication Date</label>
          <input type="date" id="edit-date" class="edit-input" />
        </div>
        <div class="edit-field">
          <label>Content (Markdown)</label>
          <textarea id="edit-body" class="edit-textarea edit-body" rows="20"></textarea>
        </div>
      </div>
      <div class="edit-panel-footer">
        <button class="edit-btn edit-btn-outline" id="edit-preview-btn">Preview</button>
        <div class="edit-footer-right">
          <button class="edit-btn edit-btn-outline" id="edit-cancel-btn">Cancel</button>
          <button class="edit-btn edit-btn-primary" id="edit-save-btn">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- PREVIEW MODAL -->
  <div id="preview-modal" class="edit-modal" style="display:none">
    <div class="edit-overlay" id="preview-overlay"></div>
    <div class="edit-panel preview-panel">
      <div class="edit-panel-header">
        <h2>Preview</h2>
        <button class="edit-close" id="preview-close" aria-label="Close">&times;</button>
      </div>
      <div class="edit-panel-body">
        <div id="preview-content" class="preview-content"></div>
      </div>
      <div class="edit-panel-footer">
        <div class="edit-footer-right">
          <button class="edit-btn edit-btn-outline" id="preview-close-btn">Close</button>
          <button class="edit-btn edit-btn-primary" id="preview-download-btn">Download .md</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
  (function() {
    const MODIFIED_KEY = 'st_admin_modified';
    const PUBLISHED_KEY = 'st_admin_published';
    const SUPABASE_URL = 'https://muhhvygrzcfuyyfkfwtb.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im11aGh2eWdyemNmdXl5Zmtmd3RiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxMzMxNjMsImV4cCI6MjEwMDcwOTE2M30.XuGE-4YAmetPRQz_6imyXVL7IFAwuZK9UnrL50oPACM';

    const loginScreen = document.getElementById('login-screen');
    const adminApp = document.getElementById('admin-app');
    const loginEmail = document.getElementById('login-email');
    const loginPassword = document.getElementById('login-password');
    const loginBtn = document.getElementById('login-btn');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutBtn = document.getElementById('logout-btn');

    function setLoginLoading(loading) {
      var btnText = loginBtn.querySelector('.login-btn-text');
      var btnLoad = loginBtn.querySelector('.login-btn-loading');
      loginBtn.disabled = loading;
      if (loading) {
        btnText.style.display = 'none';
        btnLoad.style.display = '';
        loginError.style.display = 'none';
      } else {
        btnText.style.display = '';
        btnLoad.style.display = 'none';
      }
    }

    function showLoginError(msg) {
      loginError.textContent = msg;
      loginError.style.display = '';
    }

    let supabaseClient = null;
    let supabaseLoaded = false;

    function loadSupabase() {
      return new Promise((resolve, reject) => {
        if (supabaseLoaded && window.supabase) { resolve(window.supabase); return; }
        if (window.supabase) { supabaseLoaded = true; resolve(window.supabase); return; }
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2';
        s.onload = function() { supabaseLoaded = true; resolve(window.supabase); };
        s.onerror = function() { reject(new Error('Failed to load Supabase')); };
        document.head.appendChild(s);
      });
    }

    function getSupabase() {
      if (supabaseClient) return supabaseClient;
      if (window.supabase && window.supabase.createClient) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        return supabaseClient;
      }
      return null;
    }

    function showDashboard() {
      loginScreen.style.display = 'none';
      adminApp.style.display = '';
      loadPosts();
    }

    async function checkAuth() {
      try {
        await loadSupabase();
        var sb = getSupabase();
        if (!sb) { return; }
        var result = await sb.auth.getSession();
        var session = result && result.data && result.data.session;
        if (session) { showDashboard(); }
      } catch(e) { console.error('Auth check failed:', e); }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        var email = loginEmail.value.trim();
        var password = loginPassword.value;
        if (!email || !password) {
          showLoginError('Please enter both email and password.');
          return;
        }
        setLoginLoading(true);

        try {
          await loadSupabase();
          var sb = getSupabase();
          if (!sb) {
            setLoginLoading(false);
            showLoginError('Auth service unavailable. Try again later.');
            return;
          }

          var result = await sb.auth.signInWithPassword({ email: email, password: password });
          setLoginLoading(false);

          if (result.error) {
            showLoginError('Invalid email or password. Please try again.');
            loginPassword.value = '';
            loginPassword.focus();
          } else {
            showDashboard();
          }
        } catch(err) {
          setLoginLoading(false);
          showLoginError('Connection error. Check your internet and try again.');
          console.error('Login error:', err);
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', async function() {
        try {
          var sb = getSupabase();
          if (sb) await sb.auth.signOut();
        } catch(e) {}
        localStorage.removeItem(MODIFIED_KEY);
        localStorage.removeItem(PUBLISHED_KEY);
        location.reload();
      });
    }

    checkAuth();

    // State
    var allPosts = [];
    var filteredPosts = [];
    var modifiedPosts = JSON.parse(localStorage.getItem(MODIFIED_KEY) || '{}');
    var publishedPosts = JSON.parse(localStorage.getItem(PUBLISHED_KEY) || '{}');
    var activeCat = 'all';
    var searchQuery = '';
    var currentEditId = null;

    var catColors = {
      'ai-tools': '#8b5cf6',
      'comparisons': '#5683da',
      'productivity': '#f59e0b',
      'automation': '#10b981',
      'guides': '#f472b6',
      'business-software': '#ef4444',
    };

    function loadPosts() {
      fetch('/api/posts.json')
        .then(function(res) { return res.json(); })
        .then(function(posts) {
          allPosts = posts;
          applyFilters();
          updateStats();
        })
        .catch(function(err) { console.error('Failed to load posts:', err); });
    }

  function applyFilters() {
    filteredPosts = allPosts.filter(p => {
      const matchesCat = activeCat === 'all' || p.data.category === activeCat;
      const matchesSearch = !searchQuery ||
        p.data.title.toLowerCase().includes(searchQuery) ||
        p.data.description.toLowerCase().includes(searchQuery) ||
        p.data.category.toLowerCase().includes(searchQuery);
      return matchesCat && matchesSearch;
    });
    renderTable();
  }

  function renderTable() {
    const tbody = document.getElementById('posts-tbody');
    const empty = document.getElementById('admin-empty');
    const count = document.getElementById('post-count');
    if (count) count.textContent = filteredPosts.length + ' articles';

    if (filteredPosts.length === 0) {
      tbody.innerHTML = '';
      if (empty) empty.style.display = '';
      return;
    }
    if (empty) empty.style.display = 'none';

    tbody.innerHTML = filteredPosts.map(p => {
      const isModified = !!modifiedPosts[p.id];
      const isPublished = publishedPosts[p.id] !== false;
      const color = catColors[p.data.category] || '#5683da';
      const date = new Date(p.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      return `
        <tr class="${isModified ? 'row-modified' : ''}">
          <td class="td-title">
            <div class="title-text">${p.data.title}</div>
            <div class="title-desc">${p.data.description.substring(0, 80)}...</div>
          </td>
          <td><span class="cat-pill" style="--pc:${color}">${(p.data.category || '').replace('-', ' ')}</span></td>
          <td class="td-date">${date}</td>
          <td class="td-published">
            <button class="publish-toggle ${isPublished ? 'published' : 'draft'}" onclick="window.__togglePublish('${p.id}')">
              <span class="publish-dot"></span>
              ${isPublished ? 'Published' : 'Draft'}
            </button>
          </td>
          <td class="td-actions">
            <button class="action-btn action-edit" onclick="window.__editPost('${p.id}')">Edit</button>
            <button class="action-btn action-download" onclick="window.__downloadPost('${p.id}')">.md</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  function updateStats() {
    const total = allPosts.length;
    const cats = { 'ai-tools': 0, 'comparisons': 0, 'productivity': 0, 'automation': 0 };
    allPosts.forEach(p => { if (cats[p.data.category] !== undefined) cats[p.data.category]++; });
    const modified = Object.keys(modifiedPosts).length;
    const published = allPosts.filter(p => publishedPosts[p.id] !== false).length;

    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-ai').textContent = cats['ai-tools'];
    document.getElementById('stat-comparisons').textContent = cats['comparisons'];
    document.getElementById('stat-productivity').textContent = cats['productivity'];
    document.getElementById('stat-automation').textContent = cats['automation'];
    document.getElementById('stat-modified').textContent = modified;
  }

  function togglePublish(id) {
    const isCurrentlyPublished = publishedPosts[id] !== false;
    publishedPosts[id] = !isCurrentlyPublished;
    localStorage.setItem(PUBLISHED_KEY, JSON.stringify(publishedPosts));
    renderTable();
    updateStats();
  }

  function openNewPost() {
    currentEditId = '__new__';
    document.getElementById('edit-title').value = '';
    document.getElementById('edit-desc').value = '';
    document.getElementById('edit-category').value = 'ai-tools';
    document.getElementById('edit-author').value = 'StackedTools Team';
    document.getElementById('edit-date').value = new Date().toISOString().split('T')[0];
    document.getElementById('edit-body').value = '';
    document.getElementById('edit-modal').querySelector('.edit-panel-header h2').textContent = 'New Article';
    editModal.style.display = '';
    document.body.style.overflow = 'hidden';
  }

  var newPostBtn = document.getElementById('new-post-btn');
  if (newPostBtn) {
    newPostBtn.addEventListener('click', openNewPost);
  }

  // Filters
  document.querySelectorAll('#admin-filters .admin-filter-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('#admin-filters .admin-filter-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = pill.dataset.cat;
      applyFilters();
    });
  });

  const searchInput = document.getElementById('admin-search');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Edit modal
  const editModal = document.getElementById('edit-modal');
  const editClose = document.getElementById('edit-close');
  const editOverlay = document.getElementById('edit-overlay');
  const editCancel = document.getElementById('edit-cancel-btn');
  const editSave = document.getElementById('edit-save-btn');
  const editPreview = document.getElementById('edit-preview-btn');

  function openEdit(id) {
    const post = allPosts.find(p => p.id === id);
    if (!post) return;
    currentEditId = id;

    const saved = modifiedPosts[id] || {};
    document.getElementById('edit-title').value = saved.title || post.data.title;
    document.getElementById('edit-desc').value = saved.description || post.data.description;
    document.getElementById('edit-category').value = saved.category || post.data.category;
    document.getElementById('edit-author').value = saved.author || post.data.author;
    document.getElementById('edit-date').value = (saved.pubDate || post.data.pubDate).toString().split('T')[0];
    document.getElementById('edit-body').value = saved.body || post.body;

    editModal.style.display = '';
    document.body.style.overflow = 'hidden';
  }

  function closeEdit() {
    editModal.style.display = 'none';
    document.body.style.overflow = '';
    currentEditId = null;
    document.getElementById('edit-modal').querySelector('.edit-panel-header h2').textContent = 'Edit Article';
  }

  if (editClose) editClose.addEventListener('click', closeEdit);
  if (editOverlay) editOverlay.addEventListener('click', closeEdit);
  if (editCancel) editCancel.addEventListener('click', closeEdit);

  if (editSave) {
    editSave.addEventListener('click', () => {
      if (!currentEditId) return;

      var titleVal = document.getElementById('edit-title').value.trim();
      var descVal = document.getElementById('edit-desc').value.trim();
      var bodyVal = document.getElementById('edit-body').value.trim();
      if (!titleVal || !bodyVal) {
        alert('Title and content are required.');
        return;
      }

      if (currentEditId === '__new__') {
        var slug = titleVal.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        var newPost = {
          id: slug,
          slug: slug,
          data: {
            title: titleVal,
            description: descVal,
            category: document.getElementById('edit-category').value,
            author: document.getElementById('edit-author').value,
            pubDate: document.getElementById('edit-date').value,
          },
          body: bodyVal,
        };
        allPosts.unshift(newPost);
        modifiedPosts[slug] = {
          title: titleVal,
          description: descVal,
          category: document.getElementById('edit-category').value,
          author: document.getElementById('edit-author').value,
          pubDate: document.getElementById('edit-date').value,
          body: bodyVal,
          isNew: true,
          original: null,
        };
        localStorage.setItem(MODIFIED_KEY, JSON.stringify(modifiedPosts));
      } else {
        const post = allPosts.find(p => p.id === currentEditId);
        modifiedPosts[currentEditId] = {
          title: titleVal,
          description: descVal,
          category: document.getElementById('edit-category').value,
          author: document.getElementById('edit-author').value,
          pubDate: document.getElementById('edit-date').value,
          body: bodyVal,
          original: post ? {
            title: post.data.title,
            description: post.data.description,
            category: post.data.category,
            author: post.data.author,
            pubDate: post.data.pubDate,
            body: post.body,
          } : null,
        };
        localStorage.setItem(MODIFIED_KEY, JSON.stringify(modifiedPosts));
        if (post) {
          post.data.title = titleVal;
          post.data.description = descVal;
          post.data.category = document.getElementById('edit-category').value;
          post.data.author = document.getElementById('edit-author').value;
          post.data.pubDate = document.getElementById('edit-date').value;
          post.body = bodyVal;
        }
      }

      const indicator = document.getElementById('saved-indicator');
      if (indicator) { indicator.style.display = ''; setTimeout(() => { indicator.style.display = 'none'; }, 2000); }

      applyFilters();
      updateStats();
      closeEdit();
    });
  }

  // Preview
  const previewModal = document.getElementById('preview-modal');
  const previewClose = document.getElementById('preview-close');
  const previewOverlay = document.getElementById('preview-overlay');
  const previewCloseBtn = document.getElementById('preview-close-btn');
  const previewDownload = document.getElementById('preview-download-btn');

  function closePreview() {
    previewModal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function showPreview(id) {
    const post = allPosts.find(p => p.id === id);
    if (!post) return;
    currentEditId = id;

    const title = document.getElementById('edit-title').value;
    const desc = document.getElementById('edit-desc').value;
    const category = document.getElementById('edit-category').value;
    const author = document.getElementById('edit-author').value;
    const pubDate = document.getElementById('edit-date').value;
    const body = document.getElementById('edit-body').value;

    const frontmatter = `---\ntitle: "${title}"\ndescription: "${desc}"\npubDate: ${pubDate}\ncategory: ${category}\nauthor: ${author}\n---\n\n`;
    const fullMd = frontmatter + body;

    // Simple markdown to HTML
    let html = fullMd
      .replace(/^### (.*)$/gm, '<h3>$1</h3>')
      .replace(/^## (.*)$/gm, '<h2>$1</h2>')
      .replace(/^# (.*)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`(.*?)`/g, '<code>$1</code>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n- /g, '</p><li>');

    document.getElementById('preview-content').innerHTML = `<div class="preview-article"><h1>${title}</h1><p class="preview-meta">${category} &middot; ${author} &middot; ${pubDate}</p><div class="preview-body"><p>${html}</p></div></div>`;

    previewModal.style.display = '';
    document.body.style.overflow = 'hidden';
  }

  if (previewClose) previewClose.addEventListener('click', closePreview);
  if (previewOverlay) previewOverlay.addEventListener('click', closePreview);
  if (previewCloseBtn) previewCloseBtn.addEventListener('click', closePreview);

  if (editPreview) {
    editPreview.addEventListener('click', () => {
      if (currentEditId) showPreview(currentEditId);
    });
  }

  // Download
  function downloadMd(id) {
    const post = allPosts.find(p => p.id === id);
    if (!post) return;

    const saved = modifiedPosts[id] || {};
    const title = saved.title || post.data.title;
    const desc = saved.description || post.data.description;
    const category = saved.category || post.data.category;
    const author = saved.author || post.data.author;
    const pubDate = saved.pubDate || post.data.pubDate;
    const body = saved.body || post.body;

    const frontmatter = `---\ntitle: "${title}"\ndescription: "${desc}"\npubDate: ${typeof pubDate === 'string' ? pubDate : new Date(pubDate).toISOString().split('T')[0]}\ncategory: ${category}\nauthor: ${author}\n---\n\n`;
    const content = frontmatter + body;

    const blob = new Blob([content], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${id}.md`;
    a.click();
    URL.revokeObjectURL(url);
  }

  if (previewDownload) {
    previewDownload.addEventListener('click', () => {
      if (currentEditId) {
        downloadMd(currentEditId);
        closePreview();
      }
    });
  }

  // Export all modified
  const exportAllBtn = document.getElementById('export-all-btn');
  if (exportAllBtn) {
    exportAllBtn.addEventListener('click', () => {
      const ids = Object.keys(modifiedPosts);
      if (ids.length === 0) { alert('No modified articles to export.'); return; }
      ids.forEach(id => downloadMd(id));
    });
  }

  // Global handlers
  window.__editPost = openEdit;
  window.__downloadPost = downloadMd;
  window.__togglePublish = togglePublish;
  })();
  </script>

</BaseLayout>

