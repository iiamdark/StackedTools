---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Bot, Zap, GitCompare, Workflow, Briefcase, BookOpen, ArrowRight, Layers, HelpCircle } from 'lucide-astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'ai-tools', name: 'AI Tools', description: 'Reviews, comparisons, and guides for the latest artificial intelligence software.', icon: Bot, badge: 'Popular' },
    { slug: 'productivity', name: 'Productivity', description: 'Master task management, note-taking, and workflow efficiency tools.', icon: Zap, badge: 'High CPC' },
    { slug: 'comparisons', name: 'Comparisons', description: 'Side-by-side head-to-head software feature and pricing breakdowns.', icon: GitCompare, badge: 'Buying Intent' },
    { slug: 'automation', name: 'Automation', description: 'No-code and low-code workflow automation tools and integrations.', icon: Workflow, badge: 'Trending' },
    { slug: 'business-software', name: 'Business Software', description: 'Enterprise software, CRMs, marketing, and analytics platforms.', icon: Briefcase, badge: 'B2B' },
    { slug: 'guides', name: 'Guides', description: 'Actionable tutorials and step-by-step digital tool walkthroughs.', icon: BookOpen, badge: 'How-To' },
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

import { supabase } from '../lib/supabase';

const { category } = Astro.props;
const Icon = category.icon;

const allLocalPosts = await getCollection('blog');
const localPosts = allLocalPosts
  .filter(post => post.data.category === category.slug)
  .map(post => ({
    title: post.data.title,
    slug: post.slug,
    description: post.data.description,
    author: post.data.author || 'StackedTools Team',
    pubDate: post.data.pubDate
  }));

let dbPosts: Array<{ title: string; slug: string; description: string; author: string; pubDate: Date }> = [];
try {
  const { data, error } = await supabase
    .from('posts')
    .select('*')
    .eq('category_slug', category.slug)
    .eq('published', true);

  if (!error && data) {
    dbPosts = data.map(item => ({
      title: item.title,
      slug: item.slug,
      description: item.description,
      author: item.author,
      pubDate: new Date(item.created_at)
    }));
  }
} catch (e) {}

const posts = [...dbPosts, ...localPosts];
---

<BaseLayout title={`${category.name} — StackedTools`} description={category.description}>
  <div class="container category-container">
    <header class="category-header">
      <div class="header-top">
        <div class="icon-badge">
          <Icon class="cat-hero-icon" />
        </div>
        <span class="badge badge-purple">{category.badge} Silo</span>
      </div>
      <h1>{category.name}</h1>
      <p class="lead">{category.description}</p>
    </header>

    <div class="posts-grid">
      {posts.length > 0 ? (
        posts.map((post) => (
          <div class="double-bezel post-bezel">
            <article class="post-card double-bezel-inner">
              <a href={`/blog/${post.slug}/`}>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <div class="card-footer">
                  <span class="read-more">
                    <span>Read article</span>
                    <ArrowRight class="read-icon" />
                  </span>
                </div>
              </a>
            </article>
          </div>
        ))
      ) : (
        <div class="empty-state double-bezel">
          <div class="double-bezel-inner empty-inner">
            <div class="empty-icon-box">
              <HelpCircle class="empty-icon" />
            </div>
            <h3>New Content Incoming</h3>
            <p>Articles for <strong>{category.name}</strong> are currently being finalized by our software review team. Check back soon for in-depth comparisons and benchmarks.</p>
            <a href="/" class="btn-tactile btn-secondary-tactile">
              <span>Return to Homepage</span>
              <div class="btn-icon-wrapper">&#8592;</div>
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .category-container {
    padding-top: var(--spacing-64);
    padding-bottom: var(--spacing-64);
  }

  .category-header {
    margin-bottom: var(--spacing-40);
    padding-bottom: var(--spacing-32);
    border-bottom: 1px solid var(--border-color);
  }

  .header-top {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    margin-bottom: var(--spacing-20);
  }

  .icon-badge {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-cards);
    background: rgba(86, 131, 218, 0.08);
    border: 1px solid rgba(86, 131, 218, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-electric-iris);
  }

  .cat-hero-icon {
    width: 24px;
    height: 24px;
  }

  .lead {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    margin-top: var(--spacing-8);
    max-width: 680px;
    line-height: var(--leading-body-lg);
    letter-spacing: var(--tracking-body-lg);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--spacing-24);
  }

  .post-bezel {
    transition: transform 250ms var(--ease-out-strong), border-color 250ms var(--ease-out-strong);
  }

  .post-bezel:hover {
    transform: translateY(-4px);
    border-color: var(--color-electric-iris);
  }

  .post-card a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card h2 {
    font-family: var(--font-inter);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-semibold);
    margin-top: 0;
    margin-bottom: var(--spacing-12);
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading-sm);
  }

  .post-card p {
    font-family: var(--font-inter);
    font-size: var(--text-body);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-24);
    flex: 1;
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--spacing-16);
  }

  .read-more {
    font-family: var(--font-inter);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-electric-iris);
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    letter-spacing: var(--tracking-body);
  }

  .read-icon {
    width: 14px;
    height: 14px;
    transition: transform 200ms var(--ease-out-strong);
  }

  .post-card:hover .read-icon {
    transform: translateX(3px);
  }

  .empty-state {
    grid-column: 1 / -1;
  }

  .empty-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-64) var(--spacing-32);
  }

  .empty-icon-box {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: rgba(255, 137, 100, 0.08);
    border: 1px solid rgba(255, 137, 100, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ember-pulse);
    margin-bottom: var(--spacing-24);
  }

  .empty-icon {
    width: 32px;
    height: 32px;
  }

  .empty-inner h3 {
    font-family: var(--font-inter);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-bold);
    margin-top: 0;
    margin-bottom: var(--spacing-12);
    letter-spacing: var(--tracking-heading);
  }

  .empty-inner p {
    font-family: var(--font-inter);
    max-width: 540px;
    margin-bottom: var(--spacing-32);
    color: var(--text-secondary);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    letter-spacing: var(--tracking-body-lg);
  }
</style>
