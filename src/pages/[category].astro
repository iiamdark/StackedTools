---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = [
    { slug: 'ai-tools', name: 'AI Tools', description: 'Reviews, comparisons, and guides for the latest artificial intelligence software.' },
    { slug: 'productivity', name: 'Productivity', description: 'Master task management, note-taking, and workflow efficiency tools.' },
    { slug: 'comparisons', name: 'Comparisons', description: 'Side-by-side head-to-head software feature and pricing breakdowns.' },
    { slug: 'automation', name: 'Automation', description: 'No-code and low-code workflow automation tools and integrations.' },
    { slug: 'business-software', name: 'Business Software', description: 'Enterprise software, CRMs, marketing, and analytics platforms.' },
    { slug: 'guides', name: 'Guides', description: 'Actionable tutorials and step-by-step digital tool walkthroughs.' },
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const allPosts = await getCollection('blog');
const posts = allPosts.filter(post => post.data.category === category.slug);
---

<BaseLayout title={`${category.name} — StackedTools`} description={category.description}>
  <div class="container category-container">
    <header class="category-header">
      <span class="badge">Category</span>
      <h1>{category.name}</h1>
      <p class="lead">{category.description}</p>
    </header>

    <div class="posts-grid">
      {posts.length > 0 ? (
        posts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${post.slug}/`}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">Read article &rarr;</span>
            </a>
          </article>
        ))
      ) : (
        <div class="empty-state">
          <p>Articles for <strong>{category.name}</strong> are currently being written by our editorial team. Check back soon!</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .category-container {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .category-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue);
  }

  .post-card h2 {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .post-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-blue);
  }

  .empty-state {
    grid-column: 1 / -1;
    background: var(--bg-card);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    text-align: center;
    color: var(--text-secondary);
  }
</style>
