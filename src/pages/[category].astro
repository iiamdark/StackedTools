---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Bot, Zap, GitCompare, Workflow, Briefcase, BookOpen, ArrowRight, Layers, HelpCircle } from 'lucide-astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'ai-tools', name: 'AI Tools', description: 'Reviews, comparisons, and guides for the latest artificial intelligence software.', icon: Bot, badge: 'Popular' },
    { slug: 'productivity', name: 'Productivity', description: 'Master task management, note-taking, and workflow efficiency tools.', icon: Zap, badge: 'High CPC' },
    { slug: 'comparisons', name: 'Comparisons', description: 'Side-by-side head-to-head software feature and pricing breakdowns.', icon: GitCompare, badge: 'Buying Intent' },
    { slug: 'automation', name: 'Automation', description: 'No-code and low-code workflow automation tools and integrations.', icon: Workflow, badge: 'Trending' },
    { slug: 'business-software', name: 'Business Software', description: 'Enterprise software, CRMs, marketing, and analytics platforms.', icon: Briefcase, badge: 'B2B' },
    { slug: 'guides', name: 'Guides', description: 'Actionable tutorials and step-by-step digital tool walkthroughs.', icon: BookOpen, badge: 'How-To' },
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const Icon = category.icon;
const allPosts = await getCollection('blog');
const posts = allPosts.filter(post => post.data.category === category.slug);
---

<BaseLayout title={`${category.name} — StackedTools`} description={category.description}>
  <div class="container category-container">
    <header class="category-header">
      <div class="header-top">
        <div class="icon-badge">
          <Icon class="cat-hero-icon" />
        </div>
        <span class="badge badge-purple">{category.badge} Silo</span>
      </div>
      <h1>{category.name}</h1>
      <p class="lead">{category.description}</p>
    </header>

    <div class="posts-grid">
      {posts.length > 0 ? (
        posts.map((post) => (
          <div class="double-bezel post-bezel">
            <article class="post-card double-bezel-inner">
              <a href={`/blog/${post.slug}/`}>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <span class="read-more">
                    <span>Read article</span>
                    <ArrowRight class="read-icon" />
                  </span>
                </div>
              </a>
            </article>
          </div>
        ))
      ) : (
        <div class="empty-state double-bezel">
          <div class="double-bezel-inner empty-inner">
            <div class="empty-icon-box">
              <HelpCircle class="empty-icon" />
            </div>
            <h3>New Content Incoming</h3>
            <p>Articles for <strong>{category.name}</strong> are currently being finalized by our software review team. Check back soon for in-depth comparisons and benchmarks.</p>
            <a href="/" class="btn-tactile btn-secondary-tactile">
              <span>Return to Homepage</span>
              <div class="btn-icon-wrapper">←</div>
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .category-container {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .category-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .icon-badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-inner);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
  }

  .cat-hero-icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    max-width: 680px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .post-bezel {
    transition: transform 250ms var(--ease-out-strong), border-color 250ms var(--ease-out-strong);
  }

  .post-bezel:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
  }

  .post-card a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card h2 {
    font-size: 1.35rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .post-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .read-icon {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 200ms var(--ease-out-strong);
  }

  .post-card:hover .read-icon {
    transform: translateX(3px);
  }

  .empty-state {
    grid-column: 1 / -1;
  }

  .empty-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon-box {
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-full);
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-purple);
    margin-bottom: 1.5rem;
  }

  .empty-icon {
    width: 2rem;
    height: 2rem;
  }

  .empty-inner h3 {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .empty-inner p {
    max-width: 540px;
    margin-bottom: 2rem;
  }
</style>
