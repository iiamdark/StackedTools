---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { supabase } from '../../lib/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  const localPosts = await getCollection('blog');
  const localPaths = localPosts.map((post) => ({
    params: { slug: post.id },
    props: { type: 'local' as const, post },
  }));

  let dbPaths: Array<{ params: { slug: string }; props: any }> = [];
  try {
    const { data, error } = await supabase
      .from('posts')
      .select('*')
      .eq('published', true);

    if (!error && data) {
      dbPaths = data.map((item) => ({
        params: { slug: item.slug },
        props: { type: 'db' as const, post: item },
      }));
    }
  } catch (e) {}

  return [...localPaths, ...dbPaths];
}

const props = Astro.props;
let title = '';
let description = '';
let pubDate = new Date();
let updatedDate: Date | undefined;
let author = 'StackedTools Team';
let htmlContent = '';
let RenderedContent: any = null;
let headings: Array<{ depth: number; slug: string; text: string }> = [];
let relatedPosts: Array<{ id: string; title: string; description: string; category: string; pubDate: Date; slug: string }> = [];

if (props.type === 'local') {
  const result = await render(props.post);
  RenderedContent = result.Content;
  headings = result.headings;
  title = props.post.data.title;
  description = props.post.data.description;
  pubDate = props.post.data.pubDate;
  updatedDate = props.post.data.updatedDate;
  author = props.post.data.author || 'StackedTools Team';

  const allPosts = await getCollection('blog');
  relatedPosts = allPosts
    .filter(p => p.id !== props.post.id && p.data.category === props.post.data.category)
    .slice(0, 3)
    .map(p => ({
      id: p.id,
      title: p.data.title,
      description: p.data.description,
      category: p.data.category || '',
      pubDate: p.data.pubDate,
      slug: p.slug,
    }));
} else {
  title = props.post.title;
  description = props.post.description;
  pubDate = new Date(props.post.created_at);
  updatedDate = props.post.updated_at ? new Date(props.post.updated_at) : undefined;
  author = props.post.author || 'StackedTools Team';
  htmlContent = await marked.parse(props.post.content);
}
---

<BlogPost title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} author={author} headings={headings} relatedPosts={relatedPosts}>
  {props.type === 'local' ? (
    <RenderedContent />
  ) : (
    <div set:html={htmlContent} />
  )}
</BlogPost>
