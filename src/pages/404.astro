---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — StackedTools" description="The page you're looking for doesn't exist or has been moved.">
  <div class="container notfound-container">
    <div class="notfound-content">
      <div class="notfound-code">404</div>
      <h1>Page Not Found</h1>
      <p>The page you're looking for doesn't exist or has been moved to a new location.</p>
      <div class="notfound-actions">
        <a href="/" class="btn-tactile btn-primary-tactile">
          <span>Go Home</span>
        </a>
        <a href="/blog" class="btn-tactile btn-secondary-tactile">
          <span>Browse Blog</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
  }

  .notfound-code {
    font-family: var(--font-inter);
    font-size: 120px;
    font-weight: var(--font-weight-bold);
    color: var(--color-electric-iris);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: var(--spacing-16);
    letter-spacing: -0.05em;
  }

  .notfound-content h1 {
    font-family: var(--font-inter);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-12);
    letter-spacing: var(--tracking-heading);
  }

  .notfound-content p {
    font-family: var(--font-inter);
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-32);
    letter-spacing: var(--tracking-body-lg);
  }

  .notfound-actions {
    display: flex;
    gap: var(--spacing-12);
    justify-content: center;
  }
</style>
